<configuration>
    <target name="fd">
        <default name="floppydisk.storage" value="engine/config/storage.xml"/>
        <default name="machine.definitions" value="engine/config/machine.xml"/>
        <machine name="to8"/>

        <floppydisk model="fd640">

            <section name="SCENE" track="0" face="1" sector="16"/>
            <section name="DATA"  track="1" face="0" sector="1"/>

            <directory id="0" section="INDEX" gensymbols="gen/directories/disk0/entries.asm">
                <default name="file.section" value="DATA"/>
                <default name="file.maxsize" value="0x4000"/>
                <default name="lwasm.format"     value="obj"/>

                <define symbol="loader.PAGE" value="4"/>
                <define symbol="loader.ADDRESS" value="$A000"/>

                <!-- Scroll data, raw binaries at literal attributed places -->
                <!-- generated by tools/gen_dungeon.py (committed) :        -->
                <!-- map ids (v1 12-bit packing), RAMB tileset (line-major), -->
                <!-- RAMB code buffer. RAMA holds sprites only, in front, no -->
                <!-- scroll buffer there (vscroll.planes = 2).               -->
                <!-- ******************************************************* -->
                <file name="assets.map" page="$05" address="$0000">
                    <lwasm format="raw" gensource="gen/assets/scroll/map.asm">
                        <asm xml:space="preserve">        INCLUDEBIN "assets/scroll/map.bin"</asm>
                    </lwasm>
                </file>

                <file name="assets.tilesA" page="$08" address="$0000">
                    <lwasm format="raw" gensource="gen/assets/scroll/tilesA.asm">
                        <asm xml:space="preserve">        INCLUDEBIN "assets/scroll/tiles.0.bin"</asm>
                    </lwasm>
                </file>

                <file name="assets.tilesB" page="$09" address="$0000">
                    <lwasm format="raw" gensource="gen/assets/scroll/tilesB.asm">
                        <asm xml:space="preserve">        INCLUDEBIN "assets/scroll/tiles.1.bin"</asm>
                    </lwasm>
                </file>

                <file name="assets.bufB" page="$0B" address="$0000">
                    <lwasm format="raw" gensource="gen/assets/scroll/bufB.asm">
                        <asm filename="src/assets/buffers/bufB.asm"/>
                    </lwasm>
                </file>

                <!-- Game mode -->
                <!-- ******************************************************* -->
                <file name="assets.gm.main" linkdata="LINK" page="$01" address="$6100">
                    <lwasm gensource="gen/assets/game-modes/to8/main/main.asm">
                        <asm filename="gen/directories/disk0/entries.asm"/>
                        <asm filename="src/assets/game-modes/to8/main/main.asm"/>
                    </lwasm>
                </file>

                <!-- Compiled 1bpp sprites + their imageset index. Single
                     byte-aligned variant each : 1bpp has no pre-shift.
                     Sprites: Kenney 1-Bit Pack (CC0), see ATTRIBUTION.txt. -->
                <!-- ******************************************************* -->
                <file name="assets.sprites" linkdata="LINK" page="$06" address="$0000">
                    <lwasm gensource="gen/assets/sprites/sprites.asm">
                        <!-- entries.asm brings the file id equates the index needs -->
                        <asm filename="gen/directories/disk0/entries.asm"/>
                        <gfxcomp gendir="gen/assets/sprites" gensource="gen/assets/sprites/includes.asm"
                                 genindex="gen/assets/sprites/index.asm" file="assets.sprites">
                            <!-- 1bpp sprites are byte-aligned : eight pre-shifted
                                 variants each (tools/mk_shifts.py), the game picks
                                 variant (X-x1_0)&7 and byte (X-x1_s)>>3 -->
                            <image name="knight_s0" filename="src/assets/sprites/knight_s0.png" index="0">
                                <encoder name="clear1" mirror="none" shift="0"/>
                            </image>
                            <image name="knight_s1" filename="src/assets/sprites/knight_s1.png" index="1">
                                <encoder name="clear1" mirror="none" shift="0"/>
                            </image>
                            <image name="knight_s2" filename="src/assets/sprites/knight_s2.png" index="2">
                                <encoder name="clear1" mirror="none" shift="0"/>
                            </image>
                            <image name="knight_s3" filename="src/assets/sprites/knight_s3.png" index="3">
                                <encoder name="clear1" mirror="none" shift="0"/>
                            </image>
                            <image name="knight_s4" filename="src/assets/sprites/knight_s4.png" index="4">
                                <encoder name="clear1" mirror="none" shift="0"/>
                            </image>
                            <image name="knight_s5" filename="src/assets/sprites/knight_s5.png" index="5">
                                <encoder name="clear1" mirror="none" shift="0"/>
                            </image>
                            <image name="knight_s6" filename="src/assets/sprites/knight_s6.png" index="6">
                                <encoder name="clear1" mirror="none" shift="0"/>
                            </image>
                            <image name="knight_s7" filename="src/assets/sprites/knight_s7.png" index="7">
                                <encoder name="clear1" mirror="none" shift="0"/>
                            </image>
                            <image name="ghost_s0" filename="src/assets/sprites/ghost_s0.png" index="8">
                                <encoder name="clear1" mirror="none" shift="0"/>
                            </image>
                            <image name="ghost_s1" filename="src/assets/sprites/ghost_s1.png" index="9">
                                <encoder name="clear1" mirror="none" shift="0"/>
                            </image>
                            <image name="ghost_s2" filename="src/assets/sprites/ghost_s2.png" index="10">
                                <encoder name="clear1" mirror="none" shift="0"/>
                            </image>
                            <image name="ghost_s3" filename="src/assets/sprites/ghost_s3.png" index="11">
                                <encoder name="clear1" mirror="none" shift="0"/>
                            </image>
                            <image name="ghost_s4" filename="src/assets/sprites/ghost_s4.png" index="12">
                                <encoder name="clear1" mirror="none" shift="0"/>
                            </image>
                            <image name="ghost_s5" filename="src/assets/sprites/ghost_s5.png" index="13">
                                <encoder name="clear1" mirror="none" shift="0"/>
                            </image>
                            <image name="ghost_s6" filename="src/assets/sprites/ghost_s6.png" index="14">
                                <encoder name="clear1" mirror="none" shift="0"/>
                            </image>
                            <image name="ghost_s7" filename="src/assets/sprites/ghost_s7.png" index="15">
                                <encoder name="clear1" mirror="none" shift="0"/>
                            </image>
                            <image name="dragon_s0" filename="src/assets/sprites/dragon_s0.png" index="16">
                                <encoder name="clear1" mirror="none" shift="0"/>
                            </image>
                            <image name="dragon_s1" filename="src/assets/sprites/dragon_s1.png" index="17">
                                <encoder name="clear1" mirror="none" shift="0"/>
                            </image>
                            <image name="dragon_s2" filename="src/assets/sprites/dragon_s2.png" index="18">
                                <encoder name="clear1" mirror="none" shift="0"/>
                            </image>
                            <image name="dragon_s3" filename="src/assets/sprites/dragon_s3.png" index="19">
                                <encoder name="clear1" mirror="none" shift="0"/>
                            </image>
                            <image name="dragon_s4" filename="src/assets/sprites/dragon_s4.png" index="20">
                                <encoder name="clear1" mirror="none" shift="0"/>
                            </image>
                            <image name="dragon_s5" filename="src/assets/sprites/dragon_s5.png" index="21">
                                <encoder name="clear1" mirror="none" shift="0"/>
                            </image>
                            <image name="dragon_s6" filename="src/assets/sprites/dragon_s6.png" index="22">
                                <encoder name="clear1" mirror="none" shift="0"/>
                            </image>
                            <image name="dragon_s7" filename="src/assets/sprites/dragon_s7.png" index="23">
                                <encoder name="clear1" mirror="none" shift="0"/>
                            </image>
                        </gfxcomp>
                    </lwasm>
                </file>

                <scene name="scenes.main" section="SCENE" gensource="gen/scenes/main.asm">
                    <load name="assets.gm.main"/>
                    <load name="assets.sprites"/>
                    <load name="assets.map"/>
                    <load name="assets.tilesA"/>
                    <load name="assets.tilesB"/>
                    <load name="assets.bufB"/>
                </scene>

            </directory>

            <!-- Boot loader -->
            <!-- *********************************************************** -->
            <define symbol="loader.DEFAULT_DYNAMIC_MEMORY_SIZE" value="$1000"/>
            <define symbol="boot.CHECK_MEMORY_EXT"/>

            <data section="LOADER">
                <lwasm format="raw" gensource="gen/bootloader/loader.asm">
                    <asm filename="gen/directories/disk0/entries.asm"/>
                    <asm filename="gen/directories/locations.asm"/>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_DIR_ID    equ 0</asm>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_EXEC_PAGE equ 1</asm>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_EXEC_ADDR equ $6100</asm>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_FILE_ID   equ scenes.main</asm>
                    <asm filename="engine/system/to8/bootloader/loader.asm"/>
                </lwasm>
            </data>

            <data section="BOOT" maxsize="0x100">
                <cksumfd640>
                    <lwasm format="raw">
                        <asm filename="engine/system/to8/bootloader/boot.asm"/>
                    </lwasm>
                </cksumfd640>
            </data>

            <fd  filename="to8.fd"/>
            <sd  filename="to8.sd"/>
            <sap filename="to8.sap"/>
        </floppydisk>
    </target>
</configuration>
