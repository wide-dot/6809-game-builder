<configuration>
    <target name="fd">
        <default name="floppydisk.storage" value="engine/config/storage.xml"/>

        <!-- Tiles are compiled code, like sprites : they live in a page of    -->
        <!-- their own and the map points straight at their entry points,      -->
        <!-- which the load time linker resolves.                              -->
        <layout gensymbols="gen/layout.asm">
            <region name="gamemode" page="$01" address="$6100" size="$1F00"/>
            <region name="tiles"    page="$06" address="$0000" size="$4000"/>
            <region name="terrain"  page="$07" address="$0000" size="$2000"/>
        </layout>

        <floppydisk model="fd640">

            <!-- The standard disk layout is enough : the map's 768 tile
                 references live in a map.static section, so the builder bakes
                 them against the declared regions and they emit no link data.
                 Before that gesture this example needed a whole track for LINK
                 and a tripled memory pool. -->
            <section name="SCENE" track="0" face="1" sector="16"/>
            <section name="DATA"  track="1" face="0" sector="1"/>

            <directory id="0" section="INDEX" gensymbols="gen/directories/disk0/entries.asm">
                <default name="file.section" value="DATA"/>
                <default name="file.maxsize" value="0x4000"/>
                <default name="lwasm.format"     value="obj"/>

                <define symbol="loader.PAGE" value="4"/>
                <define symbol="loader.ADDRESS" value="$A000"/>

                <!-- Compiled tiles. Each one twice : unshifted for the even   -->
                <!-- map, one pixel pre-shifted for the odd one. That pair is  -->
                <!-- what makes a 1 pixel scroll free at run time.             -->
                <!-- Declared BEFORE the game mode : its map.static section    -->
                <!-- bakes against these tiles, and a provider consumed        -->
                <!-- statically must be built before its consumer.             -->
                <!-- ******************************************************* -->
                <file name="assets.tiles" linkdata="LINK" region="tiles">
                    <lwasm gensource="gen/assets/tiles/tiles.asm">
                        <asm filename="gen/directories/disk0/entries.asm"/>
                        <!-- One sheet, sliced on the fly : tiles_0..tiles_4,   -->
                        <!-- ids in reading order — the same file shape and     -->
                        <!-- numbering leanscroll writes. Tile 0 is the poison  -->
                        <!-- tile, reserved by the "index 0 draws nothing"      -->
                        <!-- convention of <tilemap>.                           -->
                        <gfxcomp gendir="gen/assets/tiles" gensource="gen/assets/tiles/includes.asm">
                            <image name="tiles" filename="src/assets/tiles/tiles.png" grid="12x12">
                                <encoder name="draw" mirror="none" shift="0"/>
                                <encoder name="draw" mirror="none" shift="1"/>
                            </image>
                        </gfxcomp>
                    </lwasm>
                </file>

                <!-- Game mode : holds the scroll and the two maps -->
                <!-- ******************************************************* -->
                <file name="assets.gm.main" codec="zx0" linkdata="LINK" bake="auto" region="gamemode">
                    <lwasm gensource="gen/assets/game-modes/to8/main/main.asm">
                        <asm filename="gen/directories/disk0/entries.asm"/>
                        <asm filename="src/assets/game-modes/to8/main/main.asm"/>
                        <png2pal symbol="Pal_tiles" filename="src/assets/tiles/tiles.png"/>
                        <!-- The map tables, generated from the tile index map -->
                        <!-- the same way v1 generated its buffers : each      -->
                        <!-- index becomes page + address of a compiled tile,  -->
                        <!-- baked at build time in the map.static section.    -->
                        <tilemap map="src/assets/maps/map.bin" label="map.even"
                                 tiles="tiles" variant="ND0"
                                 gensource="gen/assets/maps/map_even.asm"/>
                        <tilemap map="src/assets/maps/map.bin" label="map.odd"
                                 tiles="tiles" variant="ND1"
                                 gensource="gen/assets/maps/map_odd.asm"/>
                    </lwasm>
                </file>

                <!-- Terrain collision : the mounted unit, r-type's per level
                     shape (impl + maps + bitmap). It follows the scroll through
                     two link-resolved symbols of the game mode.              -->
                <file name="assets.terrain" linkdata="LINK" region="terrain">
                    <lwasm gensource="gen/assets/terrain/terrain.asm">
                        <asm filename="gen/directories/disk0/entries.asm"/>
                        <asm filename="src/assets/terrain/terrain.asm"/>
                    </lwasm>
                </file>

                <scene name="scenes.main" section="SCENE" gensource="gen/scenes/main.asm">
                    <load name="assets.gm.main"/>
                    <load name="assets.tiles"/>
                    <load name="assets.terrain"/>
                </scene>

            </directory>

            <!-- Boot loader -->
            <!-- *********************************************************** -->
            <define symbol="loader.DEFAULT_DYNAMIC_MEMORY_SIZE" value="$1000"/>
            <define symbol="boot.CHECK_MEMORY_EXT"/>

            <data section="LOADER">
                <lwasm format="raw" gensource="gen/bootloader/loader.asm">
                    <asm filename="gen/directories/disk0/entries.asm"/>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_DIR_ID    equ 0</asm>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_EXEC_PAGE equ 1</asm>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_EXEC_ADDR equ $6100</asm>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_FILE_ID   equ scenes.main</asm>
                    <asm filename="engine/system/to8/bootloader/loader.asm"/>
                </lwasm>
            </data>

            <data section="BOOT" maxsize="0x100">
                <cksumfd640>
                    <lwasm format="raw">
                        <asm filename="engine/system/to8/bootloader/boot.asm"/>
                    </lwasm>
                </cksumfd640>
            </data>

            <fd  filename="to8.fd"/>
            <sd  filename="to8.sd"/>
            <sap filename="to8.sap"/>
        </floppydisk>
    </target>
</configuration>
