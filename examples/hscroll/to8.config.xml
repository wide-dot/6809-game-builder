<configuration>
    <target name="fd">
        <default name="floppydisk.storage" value="engine/config/storage.xml"/>

        <!-- The two code buffers are a plane each, so they need two regions.   -->
        <!-- Each is a raw binary : nothing in them is relocated, and the game  -->
        <!-- mode reaches them through the object index by page and address,    -->
        <!-- which is where the declared layout below ends up.                  -->
        <layout gensymbols="gen/layout.asm">
            <region name="gamemode" page="$01" address="$6100" size="$1F00"/>
            <region name="bandA"    page="$06" address="$0000" size="$2000"/>
            <region name="bandB"    page="$07" address="$0000" size="$2000"/>
        </layout>

        <floppydisk model="fd640">

            <section name="SCENE" track="0" face="1" sector="16"/>
            <section name="DATA"  track="1" face="0" sector="1"/>

            <directory id="0" section="INDEX" gensymbols="gen/directories/disk0/entries.asm">
                <default name="file.section" value="DATA"/>
                <default name="file.maxsize" value="0x4000"/>
                <default name="lwasm.format"     value="obj"/>

                <define symbol="loader.PAGE" value="4"/>
                <define symbol="loader.ADDRESS" value="$A000"/>

                <!-- The band, converted twice : once per memory plane.        -->
                <!-- These come first because converting also writes the .equ   -->
                <!-- describing the buffer, which the game mode below reads.    -->
                <!-- ******************************************************* -->
                <file name="assets.bandA">
                    <png2bin filename="band.png" gendir="gen/assets/band"
                             videomode="bm16" buffer="hscroll" guardcolor="11" plane="0"/>
                </file>

                <file name="assets.bandB">
                    <png2bin filename="band.png" gendir="gen/assets/band"
                             videomode="bm16" buffer="hscroll" guardcolor="11" plane="1"/>
                </file>

                <!-- Game mode -->
                <!-- ******************************************************* -->
                <file name="assets.gm.main" codec="zx0" linkdata="LINK">
                    <lwasm gensource="gen/assets/game-modes/to8/main/main.asm">
                        <asm filename="gen/directories/disk0/entries.asm"/>
                        <!-- height, guard colour and exit offset of the buffer,
                             written by the conversion above -->
                        <asm filename="gen/assets/band/band.0.0.bin.hscroll.equ"/>
                        <asm filename="src/assets/game-modes/to8/main/main.asm"/>
                        <!-- the band's own palette -->
                        <png2pal symbol="Pal_band" filename="band.png"/>
                    </lwasm>
                </file>

                <scene name="scenes.main" section="SCENE" gensource="gen/scenes/main.asm">
                    <load name="assets.gm.main" region="gamemode"/>
                    <load name="assets.bandA"   region="bandA"/>
                    <load name="assets.bandB"   region="bandB"/>
                </scene>

            </directory>

            <!-- Boot loader -->
            <!-- *********************************************************** -->
            <define symbol="loader.DEFAULT_DYNAMIC_MEMORY_SIZE" value="$1000"/>
            <define symbol="boot.CHECK_MEMORY_EXT"/>

            <data section="LOADER">
                <lwasm format="raw" gensource="gen/bootloader/loader.asm">
                    <asm filename="gen/directories/disk0/entries.asm"/>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_DIR_ID    equ 0</asm>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_EXEC_PAGE equ 1</asm>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_EXEC_ADDR equ $6100</asm>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_FILE_ID   equ scenes.main</asm>
                    <asm filename="engine/system/to8/bootloader/loader.asm"/>
                </lwasm>
            </data>

            <data section="BOOT" maxsize="0x100">
                <cksumfd640>
                    <lwasm format="raw">
                        <asm filename="engine/system/to8/bootloader/boot.asm"/>
                    </lwasm>
                </cksumfd640>
            </data>

            <fd  filename="to8.fd"/>
            <sd  filename="to8.sd"/>
            <sap filename="to8.sap"/>
        </floppydisk>
    </target>
</configuration>
