<configuration>
    <target name="fd">
        <default name="floppydisk.storage" value="engine/config/storage.xml"/>
        <floppydisk model="fd640">

            <section name="SCENE" track="0" face="1" sector="16"/>
            <section name="DATA"  track="1" face="0" sector="1"/>

            <directory id="0" section="INDEX" genbinary="gen/directories/disk0/directory.bin" gensymbols="gen/directories/disk0/entries.asm">
                <default name="direntry.section"      value="DATA"/>
                <default name="direntry.maxsize"      value="0x4000"/>
                <default name="lwasm.format"          value="obj"/>

                <define symbol="loader.PAGE" value="4"/>
                <define symbol="loader.ADDRESS" value="$A000"/>

                <!-- Loader unit test - game mode -->
                <!-- ******************************************************* -->
                <direntry name="assets.gm.loaderut" codec="zx0" loadtimelink="LINK">
                    <lwasm gensource="gen/assets/game-modes/to8/main.asm">
                        <asm filename="gen/directories/disk0/entries.asm"/>
                        <asm filename="src/assets/game-modes/to8/main.asm"/>
                    </lwasm>
                </direntry>

                <!-- Marker test files                                       -->
                <!-- aa : zx0 compressed (checks decompress + cdataz tail)   -->
                <!-- bb : raw                                                -->
                <!-- cc : zx0 compressed, loaded by scene "second" OVER bb   -->
                <!-- ******************************************************* -->
                <direntry name="data.marker.aa" codec="zx0" loadtimelink="LINK">
                    <lwasm gensource="gen/markers/marker-aa.asm">
                        <asm filename="src/assets/markers/marker-aa.asm"/>
                    </lwasm>
                </direntry>

                <direntry name="data.marker.bb" loadtimelink="LINK">
                    <lwasm gensource="gen/markers/marker-bb.asm">
                        <asm filename="src/assets/markers/marker-bb.asm"/>
                    </lwasm>
                </direntry>

                <direntry name="data.marker.cc" codec="zx0" loadtimelink="LINK">
                    <lwasm gensource="gen/markers/marker-cc.asm">
                        <asm filename="src/assets/markers/marker-cc.asm"/>
                    </lwasm>
                </direntry>

                <!-- Stress test files                                       -->
                <!-- hub    : stable, holds extern refs re-patched at link   -->
                <!-- dd/ee  : variants swapped at the same destination       -->
                <!-- iface.*: export-only files (index growth / realloc)     -->
                <!-- ******************************************************* -->
                <direntry name="data.marker.hub" loadtimelink="LINK">
                    <lwasm gensource="gen/markers/marker-hub.asm">
                        <asm filename="src/assets/markers/marker-hub.asm"/>
                    </lwasm>
                </direntry>

                <direntry name="data.marker.dd" codec="zx0" loadtimelink="LINK">
                    <lwasm gensource="gen/markers/marker-dd.asm">
                        <asm filename="src/assets/markers/marker-dd.asm"/>
                    </lwasm>
                </direntry>

                <direntry name="data.marker.ee" codec="zx0" loadtimelink="LINK">
                    <lwasm gensource="gen/markers/marker-ee.asm">
                        <asm filename="src/assets/markers/marker-ee.asm"/>
                    </lwasm>
                </direntry>

                <direntry name="iface.a" loadtimelink="LINK">
                    <lwasm gensource="gen/iface/a.asm">
                        <asm xml:space="preserve">iface.a.VALUE EXPORT</asm>
                        <asm xml:space="preserve"> SECTION _constant</asm>
                        <asm xml:space="preserve">iface.a.VALUE equ $0A01</asm>
                        <asm xml:space="preserve"> ENDSECTION</asm>
                    </lwasm>
                </direntry>

                <direntry name="iface.b" loadtimelink="LINK">
                    <lwasm gensource="gen/iface/b.asm">
                        <asm xml:space="preserve">iface.b.VALUE EXPORT</asm>
                        <asm xml:space="preserve"> SECTION _constant</asm>
                        <asm xml:space="preserve">iface.b.VALUE equ $0A02</asm>
                        <asm xml:space="preserve"> ENDSECTION</asm>
                    </lwasm>
                </direntry>

                <direntry name="iface.c" loadtimelink="LINK">
                    <lwasm gensource="gen/iface/c.asm">
                        <asm xml:space="preserve">iface.c.VALUE EXPORT</asm>
                        <asm xml:space="preserve"> SECTION _constant</asm>
                        <asm xml:space="preserve">iface.c.VALUE equ $0A03</asm>
                        <asm xml:space="preserve"> ENDSECTION</asm>
                    </lwasm>
                </direntry>

                <direntry name="iface.d" loadtimelink="LINK">
                    <lwasm gensource="gen/iface/d.asm">
                        <asm xml:space="preserve">iface.d.VALUE EXPORT</asm>
                        <asm xml:space="preserve"> SECTION _constant</asm>
                        <asm xml:space="preserve">iface.d.VALUE equ $0A04</asm>
                        <asm xml:space="preserve"> ENDSECTION</asm>
                    </lwasm>
                </direntry>

                <direntry name="iface.e" loadtimelink="LINK">
                    <lwasm gensource="gen/iface/e.asm">
                        <asm xml:space="preserve">iface.e.VALUE EXPORT</asm>
                        <asm xml:space="preserve"> SECTION _constant</asm>
                        <asm xml:space="preserve">iface.e.VALUE equ $0A05</asm>
                        <asm xml:space="preserve"> ENDSECTION</asm>
                    </lwasm>
                </direntry>

                <direntry name="iface.f" loadtimelink="LINK">
                    <lwasm gensource="gen/iface/f.asm">
                        <asm xml:space="preserve">iface.f.VALUE EXPORT</asm>
                        <asm xml:space="preserve"> SECTION _constant</asm>
                        <asm xml:space="preserve">iface.f.VALUE equ $0A06</asm>
                        <asm xml:space="preserve"> ENDSECTION</asm>
                    </lwasm>
                </direntry>

                <!-- Scenes -->
                <!-- ******************************************************* -->
                <direntry name="scenes.main" section="SCENE">
                    <lwasm format="raw" gensource="gen/scenes/main.asm">
                        <asm filename="gen/directories/disk0/entries.asm"/>
                        <asm filename="src/scenes/to8/main/scene.asm"/>
                    </lwasm>
                </direntry>

                <direntry name="scenes.second" section="SCENE">
                    <lwasm format="raw" gensource="gen/scenes/second.asm">
                        <asm filename="gen/directories/disk0/entries.asm"/>
                        <asm filename="src/scenes/to8/second/scene.asm"/>
                    </lwasm>
                </direntry>

                <direntry name="scenes.stress.hub" section="SCENE">
                    <lwasm format="raw" gensource="gen/scenes/stress-hub.asm">
                        <asm filename="gen/directories/disk0/entries.asm"/>
                        <asm filename="src/scenes/to8/stress-hub/scene.asm"/>
                    </lwasm>
                </direntry>

                <direntry name="scenes.stress.dd" section="SCENE">
                    <lwasm format="raw" gensource="gen/scenes/stress-dd.asm">
                        <asm filename="gen/directories/disk0/entries.asm"/>
                        <asm filename="src/scenes/to8/stress-dd/scene.asm"/>
                    </lwasm>
                </direntry>

                <direntry name="scenes.stress.ee" section="SCENE">
                    <lwasm format="raw" gensource="gen/scenes/stress-ee.asm">
                        <asm filename="gen/directories/disk0/entries.asm"/>
                        <asm filename="src/scenes/to8/stress-ee/scene.asm"/>
                    </lwasm>
                </direntry>

                <direntry name="scenes.stress.iface" section="SCENE">
                    <lwasm format="raw" gensource="gen/scenes/stress-iface.asm">
                        <asm filename="gen/directories/disk0/entries.asm"/>
                        <asm filename="src/scenes/to8/stress-iface/scene.asm"/>
                    </lwasm>
                </direntry>

            </directory>

            <!-- Boot loader -->
            <!-- *********************************************************** -->
            <define symbol="loader.DEFAULT_DYNAMIC_MEMORY_SIZE" value="$1000"/>

            <define symbol="boot.CHECK_MEMORY_EXT"/>

            <data section="LOADER">
                <lwasm format="raw" gensource="gen/bootloader/loader.asm">
                    <asm filename="gen/directories/disk0/entries.asm"/>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_DIR_ID    equ 0</asm>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_EXEC_PAGE equ 1</asm>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_EXEC_ADDR equ $6100</asm>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_FILE_ID   equ scenes.main</asm>
                    <asm filename="engine/system/to8/bootloader/loader.asm"/>
                </lwasm>
            </data>

            <data section="BOOT" maxsize="0x100">
                <cksumfd640>
                    <lwasm format="raw">
                        <asm filename="engine/system/to8/bootloader/boot.asm"/>
                    </lwasm>
                </cksumfd640>
            </data>

            <fd  filename="to8.fd"/>
            <sd  filename="to8.sd"/>
            <sap filename="to8.sap"/>
        </floppydisk>
    </target>
</configuration>
