<configuration>
    <target name="fd">
        <default name="floppydisk.storage" value="engine/config/storage.xml"/>
        <default name="machine.definitions" value="engine/config/machine.xml"/>
        <machine name="to8"/>

        <!-- ================================================================ -->
        <!-- Memory layout : every destination the bench loads into.          -->
        <!-- marker.b and stress.swap are the swap points the stress test     -->
        <!-- hammers : two files taking turns at one fixed destination, which  -->
        <!-- is what makes the loader's implicit unload evict the previous    -->
        <!-- content instead of leaving a stale link data slot behind.        -->
        <!-- ================================================================ -->
        <layout>
            <region name="gamemode"     page="$01" address="$6100" size="$1F00"/>
            <region name="marker.a"     page="$06" address="$0000" size="$0800"/>
            <region name="marker.b"     page="$06" address="$0800" size="$0400"/>
            <region name="stress.hub"   page="$06" address="$0C00" size="$0400"/>
            <region name="stress.swap"  page="$06" address="$1000" size="$0400"/>
            <region name="stress.zz"    page="$06" address="$1400" size="$0400"/>
            <region name="disk1.marker" page="$06" address="$1800" size="$0400"/>
            <region name="group"        page="$06" address="$1C00" size="$0400"/>
        </layout>

        <!-- ================================================================ -->
        <!-- DISK 1 : declared FIRST on purpose — the builder writes each     -->
        <!-- directory's entries.asm in a pre-pass, so disk 1 file ids are    -->
        <!-- already known when the disk 0 game mode is assembled (this is    -->
        <!-- what makes cross-disk scene/file references possible)            -->
        <!-- ================================================================ -->
        <floppydisk model="fd640">

            <section name="SCENE" track="0" face="1" sector="16"/>
            <section name="DATA"  track="1" face="0" sector="1"/>

            <directory id="1" section="INDEX" genbinary="gen/directories/disk1/directory.bin" gensymbols="gen/directories/disk1/entries.asm">
                <default name="file.section"      value="DATA"/>
                <default name="file.maxsize"      value="0x4000"/>
                <!-- the link paths ARE this bench's object (T1-T18) : keep
                     every reference load-time linked despite the auto
                     default the 3c switch installed -->
                <default name="file.bake"         value="none"/>
                <!-- same guardian rule for the codec default flip (phase 6) :
                     the raw storage paths are test objects here, files that
                     want compression say codec="zx0" one by one -->
                <default name="file.codec"        value="none"/>
                <default name="lwasm.format"          value="obj"/>

                <file name="d1.marker" codec="zx0" linkdata="LINK">
                    <lwasm gensource="gen/markers/marker-d1.asm">
                        <asm filename="src/assets/markers/marker-d1.asm"/>
                    </lwasm>
                </file>

                <!-- disk 1 scene : the disk 1 marker -->
                <scene name="d1.scenes.main" section="SCENE" gensource="gen/scenes/d1-main.asm">
                    <load name="d1.marker" region="disk1.marker"/>
                </scene>

            </directory>

            <fd  filename="to8-disk1.fd"/>
        </floppydisk>

        <!-- ================================================================ -->
        <!-- DISK 0 : boot disk                                               -->
        <!-- ================================================================ -->
        <floppydisk model="fd640">

            <section name="SCENE" track="0" face="1" sector="16"/>
            <section name="DATA"  track="1" face="0" sector="1"/>

            <directory id="0" section="INDEX" genbinary="gen/directories/disk0/directory.bin" gensymbols="gen/directories/disk0/entries.asm">
                <default name="file.section"      value="DATA"/>
                <default name="file.maxsize"      value="0x4000"/>
                <!-- the link paths ARE this bench's object (T1-T18) : keep
                     every reference load-time linked despite the auto
                     default the 3c switch installed -->
                <default name="file.bake"         value="none"/>
                <!-- same guardian rule for the codec default flip (phase 6) :
                     the raw storage paths are test objects here, files that
                     want compression say codec="zx0" one by one -->
                <default name="file.codec"        value="none"/>
                <default name="lwasm.format"          value="obj"/>

                <define symbol="loader.PAGE" value="4"/>
                <define symbol="loader.ADDRESS" value="$A000"/>

                <!-- Loader unit test - game mode -->
                <!-- ******************************************************* -->
                <file name="assets.gm.loaderut" codec="zx0" linkdata="LINK">
                    <lwasm gensource="gen/assets/game-modes/to8/main.asm">
                        <asm filename="gen/directories/disk0/entries.asm"/>
                        <asm filename="gen/directories/disk1/entries.asm"/>
                        <asm filename="src/assets/game-modes/to8/main.asm"/>
                    </lwasm>
                </file>

                <!-- Marker test files                                       -->
                <!-- aa : zx0 compressed (checks decompress + cdataz tail)   -->
                <!-- bb : raw                                                -->
                <!-- cc : zx0 compressed, loaded by scene "second" OVER bb   -->
                <!-- ******************************************************* -->
                <file name="data.marker.aa" codec="zx0" linkdata="LINK">
                    <lwasm gensource="gen/markers/marker-aa.asm">
                        <asm filename="src/assets/markers/marker-aa.asm"/>
                    </lwasm>
                </file>

                <file name="data.marker.bb" linkdata="LINK">
                    <lwasm gensource="gen/markers/marker-bb.asm">
                        <asm filename="src/assets/markers/marker-bb.asm"/>
                    </lwasm>
                </file>

                <file name="data.marker.cc" codec="zx0" linkdata="LINK">
                    <lwasm gensource="gen/markers/marker-cc.asm">
                        <asm filename="src/assets/markers/marker-cc.asm"/>
                    </lwasm>
                </file>

                <!-- Stress test files                                       -->
                <!-- hub    : stable, holds extern refs re-patched at link   -->
                <!-- dd/ee  : variants swapped at the same destination       -->
                <!-- iface.*: export-only files (index growth / realloc)     -->
                <!-- ******************************************************* -->
                <file name="data.marker.hub" linkdata="LINK">
                    <lwasm gensource="gen/markers/marker-hub.asm">
                        <asm filename="src/assets/markers/marker-hub.asm"/>
                    </lwasm>
                </file>

                <file name="data.marker.dd" codec="zx0" linkdata="LINK">
                    <lwasm gensource="gen/markers/marker-dd.asm">
                        <asm filename="src/assets/markers/marker-dd.asm"/>
                    </lwasm>
                </file>

                <file name="data.marker.ee" codec="zx0" linkdata="LINK">
                    <lwasm gensource="gen/markers/marker-ee.asm">
                        <asm filename="src/assets/markers/marker-ee.asm"/>
                    </lwasm>
                </file>

                <file name="iface.a" linkdata="LINK">
                    <lwasm gensource="gen/iface/a.asm">
                        <asm xml:space="preserve">iface.a.VALUE EXPORT</asm>
                        <asm xml:space="preserve"> SECTION _constant</asm>
                        <asm xml:space="preserve">iface.a.VALUE equ $0A01</asm>
                        <asm xml:space="preserve"> ENDSECTION</asm>
                    </lwasm>
                </file>

                <file name="iface.b" linkdata="LINK">
                    <lwasm gensource="gen/iface/b.asm">
                        <asm xml:space="preserve">iface.b.VALUE EXPORT</asm>
                        <asm xml:space="preserve"> SECTION _constant</asm>
                        <asm xml:space="preserve">iface.b.VALUE equ $0A02</asm>
                        <asm xml:space="preserve"> ENDSECTION</asm>
                    </lwasm>
                </file>

                <file name="iface.c" linkdata="LINK">
                    <lwasm gensource="gen/iface/c.asm">
                        <asm xml:space="preserve">iface.c.VALUE EXPORT</asm>
                        <asm xml:space="preserve"> SECTION _constant</asm>
                        <asm xml:space="preserve">iface.c.VALUE equ $0A03</asm>
                        <asm xml:space="preserve"> ENDSECTION</asm>
                    </lwasm>
                </file>

                <file name="iface.d" linkdata="LINK">
                    <lwasm gensource="gen/iface/d.asm">
                        <asm xml:space="preserve">iface.d.VALUE EXPORT</asm>
                        <asm xml:space="preserve"> SECTION _constant</asm>
                        <asm xml:space="preserve">iface.d.VALUE equ $0A04</asm>
                        <asm xml:space="preserve"> ENDSECTION</asm>
                    </lwasm>
                </file>

                <file name="iface.e" linkdata="LINK">
                    <lwasm gensource="gen/iface/e.asm">
                        <asm xml:space="preserve">iface.e.VALUE EXPORT</asm>
                        <asm xml:space="preserve"> SECTION _constant</asm>
                        <asm xml:space="preserve">iface.e.VALUE equ $0A05</asm>
                        <asm xml:space="preserve"> ENDSECTION</asm>
                    </lwasm>
                </file>

                <file name="iface.f" linkdata="LINK">
                    <lwasm gensource="gen/iface/f.asm">
                        <asm xml:space="preserve">iface.f.VALUE EXPORT</asm>
                        <asm xml:space="preserve"> SECTION _constant</asm>
                        <asm xml:space="preserve">iface.f.VALUE equ $0A06</asm>
                        <asm xml:space="preserve"> ENDSECTION</asm>
                    </lwasm>
                </file>

                <!-- Directory padding files (push the INDEX past 2   -->
                <!-- sectors) + churn material for the T14 stress test    -->
                <!-- ******************************************************* -->
                <file name="pad.a" linkdata="LINK">
                    <lwasm gensource="gen/pad/a.asm">
                        <asm xml:space="preserve">pad.a.VALUE EXPORT</asm>
                        <asm xml:space="preserve"> SECTION _constant</asm>
                        <asm xml:space="preserve">pad.a.VALUE equ $0B01</asm>
                        <asm xml:space="preserve"> ENDSECTION</asm>
                    </lwasm>
                </file>

                <file name="pad.b" linkdata="LINK">
                    <lwasm gensource="gen/pad/b.asm">
                        <asm xml:space="preserve">pad.b.VALUE EXPORT</asm>
                        <asm xml:space="preserve"> SECTION _constant</asm>
                        <asm xml:space="preserve">pad.b.VALUE equ $0B02</asm>
                        <asm xml:space="preserve"> ENDSECTION</asm>
                    </lwasm>
                </file>

                <file name="pad.c" linkdata="LINK">
                    <lwasm gensource="gen/pad/c.asm">
                        <asm xml:space="preserve">pad.c.VALUE EXPORT</asm>
                        <asm xml:space="preserve"> SECTION _constant</asm>
                        <asm xml:space="preserve">pad.c.VALUE equ $0B03</asm>
                        <asm xml:space="preserve"> ENDSECTION</asm>
                    </lwasm>
                </file>

                <file name="pad.d" linkdata="LINK">
                    <lwasm gensource="gen/pad/d.asm">
                        <asm xml:space="preserve">pad.d.VALUE EXPORT</asm>
                        <asm xml:space="preserve"> SECTION _constant</asm>
                        <asm xml:space="preserve">pad.d.VALUE equ $0B04</asm>
                        <asm xml:space="preserve"> ENDSECTION</asm>
                    </lwasm>
                </file>

                <file name="pad.e" linkdata="LINK">
                    <lwasm gensource="gen/pad/e.asm">
                        <asm xml:space="preserve">pad.e.VALUE EXPORT</asm>
                        <asm xml:space="preserve"> SECTION _constant</asm>
                        <asm xml:space="preserve">pad.e.VALUE equ $0B05</asm>
                        <asm xml:space="preserve"> ENDSECTION</asm>
                    </lwasm>
                </file>

                <file name="pad.f" linkdata="LINK">
                    <lwasm gensource="gen/pad/f.asm">
                        <asm xml:space="preserve">pad.f.VALUE EXPORT</asm>
                        <asm xml:space="preserve"> SECTION _constant</asm>
                        <asm xml:space="preserve">pad.f.VALUE equ $0B06</asm>
                        <asm xml:space="preserve"> ENDSECTION</asm>
                    </lwasm>
                </file>

                <file name="pad.g" linkdata="LINK">
                    <lwasm gensource="gen/pad/g.asm">
                        <asm xml:space="preserve">pad.g.VALUE EXPORT</asm>
                        <asm xml:space="preserve"> SECTION _constant</asm>
                        <asm xml:space="preserve">pad.g.VALUE equ $0B07</asm>
                        <asm xml:space="preserve"> ENDSECTION</asm>
                    </lwasm>
                </file>

                <file name="pad.h" linkdata="LINK">
                    <lwasm gensource="gen/pad/h.asm">
                        <asm xml:space="preserve">pad.h.VALUE EXPORT</asm>
                        <asm xml:space="preserve"> SECTION _constant</asm>
                        <asm xml:space="preserve">pad.h.VALUE equ $0B08</asm>
                        <asm xml:space="preserve"> ENDSECTION</asm>
                    </lwasm>
                </file>

                <file name="pad.i" linkdata="LINK">
                    <lwasm gensource="gen/pad/i.asm">
                        <asm xml:space="preserve">pad.i.VALUE EXPORT</asm>
                        <asm xml:space="preserve"> SECTION _constant</asm>
                        <asm xml:space="preserve">pad.i.VALUE equ $0B09</asm>
                        <asm xml:space="preserve"> ENDSECTION</asm>
                    </lwasm>
                </file>

                <file name="pad.j" linkdata="LINK">
                    <lwasm gensource="gen/pad/j.asm">
                        <asm xml:space="preserve">pad.j.VALUE EXPORT</asm>
                        <asm xml:space="preserve"> SECTION _constant</asm>
                        <asm xml:space="preserve">pad.j.VALUE equ $0B0A</asm>
                        <asm xml:space="preserve"> ENDSECTION</asm>
                    </lwasm>
                </file>

                <file name="pad.k" linkdata="LINK">
                    <lwasm gensource="gen/pad/k.asm">
                        <asm xml:space="preserve">pad.k.VALUE EXPORT</asm>
                        <asm xml:space="preserve"> SECTION _constant</asm>
                        <asm xml:space="preserve">pad.k.VALUE equ $0B0B</asm>
                        <asm xml:space="preserve"> ENDSECTION</asm>
                    </lwasm>
                </file>

                <file name="pad.l" linkdata="LINK">
                    <lwasm gensource="gen/pad/l.asm">
                        <asm xml:space="preserve">pad.l.VALUE EXPORT</asm>
                        <asm xml:space="preserve"> SECTION _constant</asm>
                        <asm xml:space="preserve">pad.l.VALUE equ $0B0C</asm>
                        <asm xml:space="preserve"> ENDSECTION</asm>
                    </lwasm>
                </file>

                <file name="pad.m" linkdata="LINK">
                    <lwasm gensource="gen/pad/m.asm">
                        <asm xml:space="preserve">pad.m.VALUE EXPORT</asm>
                        <asm xml:space="preserve"> SECTION _constant</asm>
                        <asm xml:space="preserve">pad.m.VALUE equ $0B0D</asm>
                        <asm xml:space="preserve"> ENDSECTION</asm>
                    </lwasm>
                </file>

                <file name="pad.n" linkdata="LINK">
                    <lwasm gensource="gen/pad/n.asm">
                        <asm xml:space="preserve">pad.n.VALUE EXPORT</asm>
                        <asm xml:space="preserve"> SECTION _constant</asm>
                        <asm xml:space="preserve">pad.n.VALUE equ $0B0E</asm>
                        <asm xml:space="preserve"> ENDSECTION</asm>
                    </lwasm>
                </file>

                <file name="pad.o" linkdata="LINK">
                    <lwasm gensource="gen/pad/o.asm">
                        <asm xml:space="preserve">pad.o.VALUE EXPORT</asm>
                        <asm xml:space="preserve"> SECTION _constant</asm>
                        <asm xml:space="preserve">pad.o.VALUE equ $0B0F</asm>
                        <asm xml:space="preserve"> ENDSECTION</asm>
                    </lwasm>
                </file>

                <file name="pad.p" linkdata="LINK">
                    <lwasm gensource="gen/pad/p.asm">
                        <asm xml:space="preserve">pad.p.VALUE EXPORT</asm>
                        <asm xml:space="preserve"> SECTION _constant</asm>
                        <asm xml:space="preserve">pad.p.VALUE equ $0B10</asm>
                        <asm xml:space="preserve"> ENDSECTION</asm>
                    </lwasm>
                </file>

                <!-- Declared last on purpose : its directory entry lives -->
                <!-- in the last INDEX sector (multi-sector dir.load)     -->
                <!-- ******************************************************* -->
                <file name="data.marker.zz" linkdata="LINK">
                    <lwasm gensource="gen/markers/marker-zz.asm">
                        <asm filename="src/assets/markers/marker-zz.asm"/>
                    </lwasm>
                </file>

                <!-- Multi object group : a raw 256 byte blob followed by an asm
                     member. Both live in one direntry, so the asm member's
                     export and relocation offsets have to be shifted by 256.
                     This is the case that used to silently produce wrong link
                     data, and the reason a group could only hold one member
                     that mattered. -->
                <file name="data.group.multi" linkdata="LINK">
                    <bin filename="src/assets/markers/prefix-256.bin"/>
                    <lwasm gensource="gen/markers/marker-grp.asm">
                        <asm filename="src/assets/markers/marker-grp.asm"/>
                    </lwasm>
                </file>

                <!-- Scenes : tables generated from these declarations      -->
                <!-- ******************************************************* -->
                <!-- main scene : game mode + two marker files -->
                <scene name="scenes.main" section="SCENE" gensource="gen/scenes/main.asm">
                    <load name="assets.gm.loaderut" region="gamemode"/>
                    <load name="data.marker.aa"     region="marker.a"/>
                    <load name="data.marker.bb"     region="marker.b"/>
                </scene>

                <!-- second scene : marker cc takes over marker bb's region -->
                <scene name="scenes.second" section="SCENE" gensource="gen/scenes/second.asm">
                    <load name="data.marker.cc" region="marker.b"/>
                </scene>

                <!-- T18's provocation : bb over cc, same region, no unload.
                     A DIFFERENT file is required — reloading the same file is
                     a dedup (slot reuse) and never reaches the overlap check. -->
                <scene name="scenes.trap" section="SCENE" gensource="gen/scenes/trap.asm">
                    <load name="data.marker.bb" region="marker.b"/>
                </scene>

                <!-- stress : stable hub file, holds refs re-patched at link -->
                <scene name="scenes.stress.hub" section="SCENE" gensource="gen/scenes/stress-hub.asm">
                    <load name="data.marker.hub" region="stress.hub"/>
                </scene>

                <!-- stress : dd and ee take turns on the swap region -->
                <scene name="scenes.stress.dd" section="SCENE" gensource="gen/scenes/stress-dd.asm">
                    <load name="data.marker.dd" region="stress.swap"/>
                </scene>

                <scene name="scenes.stress.ee" section="SCENE" gensource="gen/scenes/stress-ee.asm">
                    <load name="data.marker.ee" region="stress.swap"/>
                </scene>

                <!-- multi object group : blob + asm member, one direntry -->
                <scene name="scenes.group" section="SCENE" gensource="gen/scenes/group.asm">
                    <load name="data.group.multi" region="group"/>
                </scene>

                <!-- stress : 16 export-only padding files (link data only) -->
                <!-- combined with scenes.stress.iface this pushes the index -->
                <!-- through several realloc steps (8 -> 16 -> 24 -> 32)     -->
                <scene name="scenes.stress.pad" section="SCENE" gensource="gen/scenes/stress-pad.asm">
                    <load name="pad.a"/>
                    <load name="pad.b"/>
                    <load name="pad.c"/>
                    <load name="pad.d"/>
                    <load name="pad.e"/>
                    <load name="pad.f"/>
                    <load name="pad.g"/>
                    <load name="pad.h"/>
                    <load name="pad.i"/>
                    <load name="pad.j"/>
                    <load name="pad.k"/>
                    <load name="pad.l"/>
                    <load name="pad.m"/>
                    <load name="pad.n"/>
                    <load name="pad.o"/>
                    <load name="pad.p"/>
                </scene>

                <!-- stress : marker zz, the last directory entry -->
                <scene name="scenes.stress.zz" section="SCENE" gensource="gen/scenes/stress-zz.asm">
                    <load name="data.marker.zz" region="stress.zz"/>
                </scene>

                <!-- stress : 6 export-only interface files (link data only) -->
                <scene name="scenes.stress.iface" section="SCENE" gensource="gen/scenes/stress-iface.asm">
                    <load name="iface.a"/>
                    <load name="iface.b"/>
                    <load name="iface.c"/>
                    <load name="iface.d"/>
                    <load name="iface.e"/>
                    <load name="iface.f"/>
                </scene>

            </directory>

            <!-- Boot loader -->
            <!-- *********************************************************** -->
            <!-- A deliberately tight pool : T14 churns 22 files through the -->
            <!-- index realloc chain in it. The figure is the size that puts  -->
            <!-- the top of the pool at $BE50, where it has always been ; it  -->
            <!-- moves when the loader's size does, since the pool follows the -->
            <!-- loader in memory. -->
            <define symbol="loader.DEFAULT_DYNAMIC_MEMORY_SIZE" value="$0EE1"/>

            <define symbol="boot.CHECK_MEMORY_EXT"/>

            <data section="LOADER">
                <lwasm format="raw" gensource="gen/bootloader/loader.asm">
                    <asm filename="gen/directories/disk0/entries.asm"/>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_DIR_ID    equ 0</asm>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_EXEC_PAGE equ 1</asm>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_EXEC_ADDR equ $6100</asm>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_FILE_ID   equ scenes.main</asm>
                    <asm filename="engine/system/to8/bootloader/loader.asm"/>
                </lwasm>
            </data>

            <data section="BOOT" maxsize="0x100">
                <cksumfd640>
                    <lwasm format="raw">
                        <asm filename="engine/system/to8/bootloader/boot.asm"/>
                    </lwasm>
                </cksumfd640>
            </data>

            <fd  filename="to8.fd"/>
            <sd  filename="to8.sd"/>
            <sap filename="to8.sap"/>
        </floppydisk>
    </target>
</configuration>
