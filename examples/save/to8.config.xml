<configuration>
    <target name="fd">
        <default name="floppydisk.storage" value="engine/config/storage.xml"/>
        <default name="machine.definitions" value="engine/config/machine.xml"/>
        <machine name="to8"/>

        <!-- SAVE : one resident game mode that reads, writes and reads back a  -->
        <!-- writable file (loader.file.save), between two raw neighbours       -->
        <!-- (readme.md).                                                      -->
        <floppydisk model="fd640">

            <section name="SCENE" track="0" face="1" sector="16"/>
            <section name="DATA"  track="1" face="0" sector="1"/>

            <directory id="0" section="INDEX" genbinary="gen/directories/disk0/directory.bin" gensymbols="gen/directories/disk0/entries.asm">
                <default name="file.section"      value="DATA"/>
                <default name="file.maxsize"      value="0x4000"/>
                <default name="lwasm.format"      value="obj"/>

                <define symbol="loader.PAGE" value="4"/>
                <define symbol="loader.ADDRESS" value="$A000"/>

                <file name="gm.save" linkdata="LINK" page="$01" address="$6300">
                    <lwasm gensource="gen/gm/save.asm">
                        <asm filename="gen/directories/disk0/entries.asm"/>
                        <asm filename="src/main.asm"/>
                    </lwasm>
                </file>

                <scene name="scenes.save" section="SCENE" gensource="gen/scenes/save.asm">
                    <load name="gm.save"/>
                </scene>

                <!-- loaded by the game mode itself, in this order on the disk -->
                <file name="before.data" codec="none">
                    <lwasm format="raw"><asm filename="src/data/before.asm"/></lwasm>
                </file>
                <file name="save.data" codec="none" writable="true">
                    <lwasm format="raw"><asm filename="src/data/save.asm"/></lwasm>
                </file>
                <file name="after.data" codec="none">
                    <lwasm format="raw"><asm filename="src/data/after.asm"/></lwasm>
                </file>
            </directory>

            <define symbol="loader.DEFAULT_DYNAMIC_MEMORY_SIZE" value="$1000"/>
            <define symbol="boot.CHECK_MEMORY_EXT"/>

            <data section="LOADER">
                <lwasm format="raw" gensource="gen/bootloader/loader.asm">
                    <asm filename="gen/directories/disk0/entries.asm"/>
                    <asm filename="gen/directories/locations.asm"/>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_DIR_ID    equ 0</asm>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_EXEC_PAGE equ 1</asm>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_EXEC_ADDR equ $6300</asm>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_FILE_ID   equ scenes.save</asm>
                    <asm filename="engine/system/to8/bootloader/loader.asm"/>
                </lwasm>
            </data>

            <data section="BOOT" maxsize="0x100">
                <cksumfd640>
                    <lwasm format="raw">
                        <asm filename="engine/system/to8/bootloader/boot.asm"/>
                    </lwasm>
                </cksumfd640>
            </data>

            <fd  filename="to8.fd"/>
        </floppydisk>
    </target>
</configuration>
