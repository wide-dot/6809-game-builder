<configuration>

    <target name="assets">
        <pcm filename="src/assets/sounds/samples" bit8to6="true"/>
    </target>

    <target name="fd">
        <define symbol="TO8" value="0"/>
        <phoneme filename="src/assets/sounds/text/demo.txt" genbinary="src/assets/sounds/text/demo.asm"/>

        <default name="floppydisk.storage" value="engine/config/storage.xml"/>
        <default name="machine.definitions" value="engine/config/machine.xml"/>
        <machine name="to8"/>

        <layout>
            <!-- the sound blobs : the builder lays them out over these zones
                 and the load-time linker resolves their labels wherever they
                 land — nothing assumes an order or a base address -->
            <arena name="sound.data">
                <zone page="$05" address="$0000" size="$4000"/>
                <zone page="$06" address="$0000" size="$2000"/>
            </arena>
        </layout>

        <floppydisk model="fd640">

            <section name="SCENE" track="1" face="0" sector="3"/>
            <section name="DATA"  track="1" face="0" sector="4"/>

            <directory id="0" section="INDEX" genbinary="gen/directories/disk0/directory.bin" gensymbols="gen/directories/disk0/entries.asm">
                <default name="file.section"      value="DATA"/>
                <default name="file.maxsize"      value="0x4000"/>
                <default name="lwasm.format"          value="obj"/>

                <define symbol="loader.PAGE" value="4"/>
                <define symbol="loader.ADDRESS" value="$A000"/>

                <!-- Title - game mode -->
                <!-- ******************************************************* -->
                <file name="assets.gm.title" linkdata="LINK" page="$01" address="$6300">
                    <lwasm gensource="gen/assets/game-modes/title/main-test.asm">
                        <asm filename="gen/directories/disk0/entries.asm"/>
                        <asm filename="src/assets/game-modes/title/main-test.asm"/>
                    </lwasm>
                </file>

                <!-- Test - sample data -->
                <!-- ******************************************************* -->
                <file name="assets.sounds.samples" linkdata="LINK" arena="sound.data">
                    <lwasm gensource="gen/assets/sounds/samples/5-timpani.6bit.asm">
                        <label name="samples.timpani"/><includebin filename="src/assets/sounds/samples/5-timpani.6bit.bin" />
                    </lwasm>
                </file>

                <!-- Test - sound data -->
                <!-- ******************************************************* -->
                <file name="assets.sounds.ym" linkdata="LINK" arena="sound.data">
                    <lwasm gensource="gen/assets/sounds/vgm/ym-sweet.ymm">
                        <label name="sounds.ym"/>
                    </lwasm>
                    <vgm2ymm filename="src/assets/sounds/vgm/ym-sweet.vgm" genbinary="src/assets/sounds/vgm/ym-sweet.ymm"/>
                </file>

                <file name="assets.sounds.ym.rythm" linkdata="LINK" arena="sound.data">
                    <lwasm gensource="gen/assets/sounds/vgm/ym-rythm.ymm">
                        <label name="sounds.ym.rythm"/>
                    </lwasm>
                    <vgm2ymm filename="src/assets/sounds/vgm/ym-rythm.vgm" genbinary="src/assets/sounds/vgm/ym-rythm.ymm"/>
                </file>

                <file name="assets.sounds.sn" linkdata="LINK" arena="sound.data">
                    <lwasm gensource="gen/assets/sounds/vgm/sn-melody.vgc">
                        <label name="sounds.sn"/>
                    </lwasm>
                        <vgm2vgc filename="src/assets/sounds/vgm/sn-melody.vgm" genbinary="src/assets/sounds/vgm/sn-melody.vgc"/>
                </file>

                <file name="assets.sounds.sn.noise" linkdata="LINK" arena="sound.data">
                    <lwasm gensource="gen/assets/sounds/vgm/sn-noise.vgc">
                        <label name="sounds.sn.noise"/>
                    </lwasm>
                        <vgm2vgc filename="src/assets/sounds/vgm/sn-noise.vgm" genbinary="src/assets/sounds/vgm/sn-noise.vgc"/>
                </file>

                <file name="assets.sounds.sn.music" linkdata="LINK" arena="sound.data">
                    <lwasm gensource="gen/assets/sounds/vgm/music.vgc">
                        <label name="sounds.sn.music"/>
                    </lwasm>
                        <vgm2vgc filename="src/assets/sounds/vgm/music.vgm" genbinary="src/assets/sounds/vgm/music.vgc"/>
                </file>

                <file name="assets.sounds.ym.music" linkdata="LINK" arena="sound.data">
                    <lwasm gensource="gen/assets/sounds/vgm/music.ymm">
                        <label name="sounds.ym.music"/>
                    </lwasm>
                    <vgm2ymm filename="src/assets/sounds/vgm/music.vgm" genbinary="src/assets/sounds/vgm/music.ymm"/>
                </file>

                <!-- Test - mea8000 data -->
                <!-- ******************************************************* -->

                <file name="assets.sounds.mea8000" linkdata="LINK" arena="sound.data">
                    <lwasm gensource="gen/assets/sounds/text/demo.asm">
                        <label name="sounds.mea8000"/>
                        <asm xml:space="preserve"> SECTION code</asm>
                        <asm filename="src/assets/sounds/text/demo.asm"/>
                        <asm filename="engine/system/thomson/sound/mea8000.phonemes.const.asm"/>
                        <asm xml:space="preserve"> ENDSECTION</asm>
                    </lwasm>
                </file>

                <!-- Test - sound player dynamic port -->
                <!-- ******************************************************* -->
                <file name="engine.system.to8.sound.mplus.const" linkdata="LINK" arena="sound.data">
                    <lwasm gensource="gen/system/to8/sound/mplus.const.asm">
                        <asm filename="engine/system/to8/sound/mplus.const.asm"/>
                    </lwasm>
                </file>

                <!-- Scenes : table generated from this declaration -->
                <!-- ******************************************************* -->
                <scene name="scenes.title" section="SCENE" gensource="gen/scenes/title-test.asm">
                    <load name="assets.gm.title"/>
                    <!-- ranged by the builder ; the linker finds every label -->
                    <load name="assets.sounds.samples"/>
                    <load name="assets.sounds.sn"/>
                    <load name="assets.sounds.sn.noise"/>
                    <load name="assets.sounds.ym"/>
                    <load name="assets.sounds.ym.rythm"/>
                    <load name="engine.system.to8.sound.mplus.const"/>
                    <load name="assets.sounds.mea8000"/>
                    <load name="assets.sounds.sn.music"/>
                    <load name="assets.sounds.ym.music"/>
                </scene>

            </directory>

            <!-- Boot loader -->
            <!-- *********************************************************** -->
            <define symbol="loader.DEFAULT_DYNAMIC_MEMORY_SIZE" value="$1000"/>

            <define symbol="boot.CHECK_MEMORY_EXT"/>

            <data section="LOADER">
                <lwasm format="raw" gensource="gen/bootloader/loader.asm">
                    <asm filename="gen/directories/disk0/entries.asm"/>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_DIR_ID    equ 0</asm>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_EXEC_PAGE equ 1</asm>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_EXEC_ADDR equ $6300</asm>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_FILE_ID   equ scenes.title</asm>
                    <asm filename="engine/system/to8/bootloader/loader.asm"/>
                </lwasm>
            </data>

            <data section="BOOT" maxsize="0x100">   
                <cksumfd640>
                    <lwasm format="raw" gensource="gen/system/to8/bootloader/boot.asm">
                        <asm filename="engine/system/to8/bootloader/boot.asm"/>
                    </lwasm>
                </cksumfd640>
            </data>

            <fd  filename="to8-mplus-test.fd"/>
            <sd  filename="to8-mplus-test.sd"/>
            <sap filename="to8-mplus-test.sap"/>
            <hfe filename="to8-mplus-test.hfe"/>
        </floppydisk>
    </target>
</configuration>

