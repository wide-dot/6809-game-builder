<configuration>
    <target name="fd">
        <default name="floppydisk.storage" value="engine/config/storage.xml"/>
        <default name="machine.definitions" value="engine/config/machine.xml"/>
        <machine name="to8"/>

        <floppydisk model="fd640">

            <section name="SCENE" track="0" face="1" sector="16"/>
            <section name="DATA"  track="1" face="0" sector="1"/>

            <!-- the manager : one copy in each half of the video half page
                 (gfxlock mounts the half of the buffer it draws) -->
            <layout>
                <region name="sprites.half0" page="$00" slice="0" address="$4000" size="$2000"/>
                <region name="sprites.half1" page="$00" slice="1" address="$4000" size="$2000"/>
            </layout>

            <directory id="0" section="INDEX" gensymbols="gen/directories/disk0/entries.asm">
                <default name="file.section" value="DATA"/>
                <default name="file.maxsize" value="0x4000"/>
                <default name="lwasm.format"     value="obj"/>

                <define symbol="loader.PAGE" value="4"/>
                <define symbol="loader.ADDRESS" value="$A000"/>

                <!-- the shape set, read by the sprites and the walkers alike
                     (the defaults, written out) -->
                <default name="spritestream.segment" value="6"/>
                <default name="spritestream.rows" value="2:2,3:2"/>
                <default name="spritestream.mirrorable" value="true"/>
                <default name="spritestream.save" value="true"/>

                <!-- Game mode : the tests -->
                <!-- ******************************************************* -->
                <file name="assets.gm.main" linkdata="LINK" page="$01" address="$6100">
                    <lwasm gensource="gen/assets/game-modes/to8/main/main.asm">
                        <asm filename="gen/directories/disk0/entries.asm"/>
                        <asm filename="src/assets/game-modes/to8/main/main.asm"/>
                    </lwasm>
                </file>

                <!-- The sprites : each a picture and the same moved right by
                     2 pixels (tools/gen_spritestream.py) ; records adr_<name> -->
                <!-- ******************************************************* -->
                <file name="assets.sprites" linkdata="LINK" page="$06" address="$0000">
                    <lwasm gensource="gen/assets/sprites/sprites.asm">
                        <spritestream gendir="gen/assets/sprites/streams" gensource="gen/assets/sprites/includes.asm"
                                      genreport="gen/assets/sprites/report.csv">
                            <sprite name="flag"  filename="src/assets/sprites/flag.png"  shifted="src/assets/sprites/flag_s.png"/>
                            <sprite name="flagm" filename="src/assets/sprites/flagm.png" shifted="src/assets/sprites/flagm_s.png"/>
                            <sprite name="slab"  filename="src/assets/sprites/slab.png"  shifted="src/assets/sprites/slab_s.png"/>
                            <sprite name="tall"  filename="src/assets/sprites/tall.png"  shifted="src/assets/sprites/tall_s.png"/>
                        </spritestream>
                    </lwasm>
                </file>

                <!-- The manager, one copy a half : the walkers with their clip
                     mode, then the engine's runtime -->
                <!-- ******************************************************* -->
                <file name="assets.manager0" linkdata="LINK" region="sprites.half0">
                    <lwasm gensource="gen/assets/manager0.asm">
                        <asm xml:space="preserve">spritestream.HALF equ 0</asm>
                        <asm filename="src/manager.asm"/>
                        <spritestream genwalker="gen/assets/walker.asm" clip="true"/>
                        <asm filename="engine/graphics/sprite/stream/spritestream.asm"/>
                        <asm xml:space="preserve"> ENDSECTION</asm>
                    </lwasm>
                </file>
                <file name="assets.manager1" linkdata="LINK" region="sprites.half1">
                    <lwasm gensource="gen/assets/manager1.asm">
                        <asm xml:space="preserve">spritestream.HALF equ 1</asm>
                        <asm filename="src/manager.asm"/>
                        <spritestream genwalker="gen/assets/walker.asm" clip="true"/>
                        <asm filename="engine/graphics/sprite/stream/spritestream.asm"/>
                        <asm xml:space="preserve"> ENDSECTION</asm>
                    </lwasm>
                </file>

                <scene name="scenes.main" section="SCENE" gensource="gen/scenes/main.asm">
                    <load name="assets.gm.main"/>
                    <load name="assets.sprites"/>
                    <load name="assets.manager0"/>
                    <load name="assets.manager1"/>
                </scene>

            </directory>

            <!-- Boot loader -->
            <!-- *********************************************************** -->
            <define symbol="loader.DEFAULT_DYNAMIC_MEMORY_SIZE" value="$1000"/>
            <define symbol="boot.CHECK_MEMORY_EXT"/>

            <data section="LOADER">
                <lwasm format="raw" gensource="gen/bootloader/loader.asm">
                    <asm filename="gen/directories/disk0/entries.asm"/>
                    <asm filename="gen/directories/locations.asm"/>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_DIR_ID    equ 0</asm>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_EXEC_PAGE equ 1</asm>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_EXEC_ADDR equ $6100</asm>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_FILE_ID   equ scenes.main</asm>
                    <asm filename="engine/system/to8/bootloader/loader.asm"/>
                </lwasm>
            </data>

            <data section="BOOT" maxsize="0x100">
                <cksumfd640>
                    <lwasm format="raw">
                        <asm filename="engine/system/to8/bootloader/boot.asm"/>
                    </lwasm>
                </cksumfd640>
            </data>

            <fd  filename="to8.fd"/>
        </floppydisk>
    </target>
</configuration>
