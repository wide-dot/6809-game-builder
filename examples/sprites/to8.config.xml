<configuration>
    <target name="fd">
        <default name="floppydisk.storage" value="engine/config/storage.xml"/>

        <floppydisk model="fd640">

            <section name="SCENE" track="0" face="1" sector="16"/>
            <section name="DATA"  track="1" face="0" sector="1"/>

            <directory id="0" section="INDEX" gensymbols="gen/directories/disk0/entries.asm">
                <default name="file.section" value="DATA"/>
                <default name="file.maxsize" value="0x4000"/>
                <default name="lwasm.format"     value="obj"/>

                <define symbol="loader.PAGE" value="4"/>
                <define symbol="loader.ADDRESS" value="$A000"/>

                <!-- Game mode -->
                <!-- ******************************************************* -->
                <file name="assets.gm.main" codec="zx0" linkdata="LINK" bake="auto" page="$01" address="$6100">
                    <lwasm gensource="gen/assets/game-modes/to8/main/main.asm">
                        <asm filename="gen/directories/disk0/entries.asm"/>
                        <asm filename="src/assets/game-modes/to8/main/main.asm"/>
                        <!-- the sprites' own palette. It belongs to the game
                             mode's unit rather than the sprites page: the
                             runtime reads it through Pal_current under
                             interrupt, so it has to stay addressable. -->
                        <png2pal symbol="Pal_sprites" filename="src/assets/sprites/glyph.png"/>
                    </lwasm>
                </file>

                <!-- Compiled sprites + their imageset index -->
                <!-- ******************************************************* -->
                <file name="assets.sprites" linkdata="LINK" bake="auto" page="$06" address="$0000">
                    <lwasm gensource="gen/assets/sprites/sprites.asm">
                        <!-- entries.asm brings the file id equates the index needs -->
                        <asm filename="gen/directories/disk0/entries.asm"/>
                        <gfxcomp gendir="gen/assets/sprites" gensource="gen/assets/sprites/includes.asm"
                                 genindex="gen/assets/sprites/index.asm" file="assets.sprites">
                            <image name="glyph" filename="src/assets/sprites/glyph.png" index="0">
                                <encoder name="bdraw" mirror="none" shift="0"/>
                                <!-- the pre-shifted variant : the runtime picks
                                     between the two on the position's parity -->
                                <encoder name="bdraw" mirror="none" shift="1"/>
                            </image>
                            <image name="marker" filename="src/assets/sprites/marker.png" index="1">
                                <encoder name="bdraw" mirror="none" shift="0"/>
                                <encoder name="draw" mirror="none" shift="0"/>
                            </image>
                            <!-- A compressed image. It answers to the draw slot,
                                 which is what puts it in the index at all, and
                                 it is full width on purpose : the zx0 encoder
                                 drops transparency and emits a contiguous run
                                 of the plane buffer, so decompression overwrites
                                 whole lines. That makes it a background, not a
                                 sprite. -->
                            <image name="band" filename="src/assets/sprites/band.png" index="2">
                                <encoder name="zx0" mirror="none" shift="0"/>
                            </image>
                        </gfxcomp>
                        <!-- the frame table AnimateSprite walks ; frames name
                             images, the element writes their imageset symbol -->
                        <animation name="Ani_glyph" duration="8">
                            <frame image="glyph"/>
                            <frame image="marker"/>
                        </animation>
                    </lwasm>
                </file>

                <scene name="scenes.main" section="SCENE" gensource="gen/scenes/main.asm">
                    <load name="assets.gm.main"/>
                    <load name="assets.sprites"/>
                </scene>

            </directory>

            <!-- Boot loader -->
            <!-- *********************************************************** -->
            <define symbol="loader.DEFAULT_DYNAMIC_MEMORY_SIZE" value="$1000"/>
            <define symbol="boot.CHECK_MEMORY_EXT"/>

            <data section="LOADER">
                <lwasm format="raw" gensource="gen/bootloader/loader.asm">
                    <asm filename="gen/directories/disk0/entries.asm"/>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_DIR_ID    equ 0</asm>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_EXEC_PAGE equ 1</asm>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_EXEC_ADDR equ $6100</asm>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_FILE_ID   equ scenes.main</asm>
                    <asm filename="engine/system/to8/bootloader/loader.asm"/>
                </lwasm>
            </data>

            <data section="BOOT" maxsize="0x100">
                <cksumfd640>
                    <lwasm format="raw">
                        <asm filename="engine/system/to8/bootloader/boot.asm"/>
                    </lwasm>
                </cksumfd640>
            </data>

            <fd  filename="to8.fd"/>
            <sd  filename="to8.sd"/>
            <sap filename="to8.sap"/>
        </floppydisk>
    </target>
</configuration>
