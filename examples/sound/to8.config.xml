<configuration>
    <target name="fd">
        <default name="floppydisk.storage" value="engine/config/storage.xml"/>

        <!-- Memory layout : the fixed regions scenes load into.           -->
        <!-- A region is where scenes hand memory over to one another :    -->
        <!-- same destination, so the loader implicitly unloads the        -->
        <!-- previous content. Sizes are byte budgets.                     -->

        <floppydisk model="fd640">

            <section name="SCENE" track="0" face="1" sector="16"/>
            <section name="DATA"  track="1" face="0" sector="1"/>

            <directory id="0" section="INDEX" genbinary="gen/directories/disk0/directory.bin" gensymbols="gen/directories/disk0/entries.asm">
                <default name="file.section"      value="DATA"/>
                <default name="file.maxsize"      value="0x4000"/>
                <default name="lwasm.format"          value="obj"/>

                <define symbol="loader.PAGE" value="4"/>
                <define symbol="loader.ADDRESS" value="$A000"/>

                <!-- Title - game mode -->
                <!-- ******************************************************* -->
                <file name="assets.gm.title" codec="zx0" linkdata="LINK" bake="auto" page="$01" address="$6100">
                    <lwasm gensource="gen/assets/game-modes/to8/title/main.asm">
                        <asm filename="gen/directories/disk0/entries.asm"/>
                        <asm filename="src/assets/game-modes/to8/title/main.asm"/>
                    </lwasm>
                </file>

                <!-- Title - sound player -->
                <!-- ******************************************************* -->
                <file name="engine.object.sound.ymm" codec="zx0" linkdata="LINK" bake="auto" page="$06" address="$0000">
                    <lwasm>
                        <asm filename="engine/sound/ymm.asm"/>
                    </lwasm>
                </file>

                <file name="engine.object.sound.vgc" codec="zx0" linkdata="LINK" bake="auto" page="$07" address="$0000">
                    <lwasm>
                        <asm filename="engine/sound/vgc.buffers.asm"/>
                        <asm filename="engine/sound/vgc.asm"/>
                    </lwasm>
                </file>

                <!-- Title - sound data -->
                <!-- ******************************************************* -->
                <file name="assets.sounds.title.ymm" linkdata="LINK" bake="auto" page="$06" address="$0480">
                    <lwasm>
                        <label name="sounds.title.ymm"/>
                    </lwasm>
                    <vgm2ymm filename="src/assets/sounds/title/resources/rtype-title.vgm" genbinary="src/assets/sounds/title/music.ymm" codec="zx0"/>
                </file>

                <file name="assets.sounds.title.vgc" linkdata="LINK" bake="auto" page="$07" address="$0A80">
                    <lwasm>
                        <label name="sounds.title.vgc"/>
                    </lwasm>
                        <vgm2vgc filename="src/assets/sounds/title/resources/rtype-title.vgm" genbinary="src/assets/sounds/title/music.vgc"/>
                </file>

                <!-- Title - sound player dynamic port -->
                <!-- ******************************************************* -->
                <file name="engine.system.to8.sound.ym.const" linkdata="LINK">
                    <lwasm>
                        <asm filename="engine/system/to8/sound/ym.2.const.asm"/>
                    </lwasm>
                </file>

                <file name="engine.system.to8.sound.sn.const" linkdata="LINK">
                    <lwasm>
                        <asm filename="engine/system/to8/sound/sn.2.const.asm"/>
                    </lwasm>
                </file>

                <!-- Level1 - sound data -->
                <!-- ******************************************************* -->
                <file name="assets.sounds.level1.ymm" linkdata="LINK" bake="auto" page="$06" address="$0480">
                    <lwasm>
                        <label name="sounds.level1.ymm"/>
                    </lwasm>
                    <vgm2ymm filename="src/assets/sounds/level1/resources/rtype-level1.vgm" genbinary="src/assets/sounds/level1/music.ymm" codec="zx0"/>
                </file>

                <file name="assets.sounds.level1.vgc" linkdata="LINK" bake="auto" page="$07" address="$0A80">
                    <lwasm>
                        <label name="sounds.level1.vgc"/>
                    </lwasm>
                        <vgm2vgc filename="src/assets/sounds/level1/resources/rtype-level1.vgm" genbinary="src/assets/sounds/level1/music.vgc"/>
                </file>

                <!-- Scenes : tables generated from these declarations      -->
                <!-- ******************************************************* -->
                <scene name="scenes.title" section="SCENE" gensource="gen/scenes/title.asm">
                    <load name="assets.gm.title"/>
                    <load name="engine.object.sound.ymm"/>
                    <load name="engine.object.sound.vgc"/>
                    <load name="assets.sounds.title.ymm"/>
                    <load name="assets.sounds.title.vgc"/>
                    <!-- link data only (export-only files) -->
                    <load name="engine.system.to8.sound.ym.const"/>
                    <load name="engine.system.to8.sound.sn.const"/>
                </scene>

                <scene name="scenes.level1" section="SCENE" gensource="gen/scenes/level1.asm">
                    <load name="assets.sounds.level1.ymm"/>
                    <load name="assets.sounds.level1.vgc"/>
                </scene>

            </directory>

            <!-- Boot loader -->
            <!-- *********************************************************** -->
            <define symbol="loader.DEFAULT_DYNAMIC_MEMORY_SIZE" value="$1000"/>

            <define symbol="boot.CHECK_MEMORY_EXT"/>

            <data section="LOADER">
                <lwasm format="raw" gensource="gen/bootloader/loader.asm">
                    <asm filename="gen/directories/disk0/entries.asm"/>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_DIR_ID    equ 0</asm>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_EXEC_PAGE equ 1</asm>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_EXEC_ADDR equ $6100</asm>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_FILE_ID   equ scenes.title</asm>
                    <asm filename="engine/system/to8/bootloader/loader.asm"/>
                </lwasm>
            </data>

            <data section="BOOT" maxsize="0x100">   
                <cksumfd640>
                    <lwasm format="raw">
                        <asm filename="engine/system/to8/bootloader/boot.asm"/>
                    </lwasm>
                </cksumfd640>
            </data>

            <fd  filename="to8.fd"/>
            <sd  filename="to8.sd"/>
            <sap filename="to8.sap"/>
            <hfe filename="to8.hfe"/>
        </floppydisk>
    </target>
</configuration>

