<configuration>
    <target name="fd">
        <default name="floppydisk.storage" value="engine/config/storage.xml"/>
        <default name="machine.definitions" value="engine/config/machine.xml"/>
        <machine name="mo6"/>

        <!-- Memory layout : the MO6 map differs from the TO8 one, so the   -->
        <!-- layout is declared per target and not shared.                  -->
        <layout>
            <!-- On ne declare que les CONTRAINTES : la page (ce qui voyage    -->
            <!-- ensemble) et, quand elle compte, l'adresse. Les tailles se     -->
            <!-- mesurent — les budgets ecrits a la main d'un lecteur YM qui a  -->
            <!-- grossi de 33 octets faisaient deborder la region suivante.     -->
            <region name="ymm.player" page="$06" address="$B000"/>
            <region name="ymm.data"   page="$06"/>
            <region name="vgc.player" page="$07" address="$B000"/>
            <region name="vgc.data"   page="$07"/>
        </layout>

        <floppydisk model="fd640">

            <section name="SCENE" track="0" face="1" sector="16"/>
            <section name="DATA"  track="1" face="0" sector="1"/>

            <directory id="0" section="INDEX" genbinary="gen/directories/disk0/directory.bin" gensymbols="gen/directories/disk0/entries.asm">
                <default name="file.section"      value="DATA"/>
                <default name="file.maxsize"      value="0x4000"/>
                <default name="lwasm.format"          value="obj"/>

                <define symbol="loader.PAGE" value="4"/>
                <define symbol="loader.ADDRESS" value="$6000"/>

                <!-- Title - game mode -->
                <!-- ******************************************************* -->
                <file name="assets.gm.title" linkdata="LINK" page="$01" address="$2100">
                    <lwasm gensource="gen/assets/game-modes/mo6/title/main.asm">
                        <asm filename="gen/directories/disk0/entries.asm"/>
                        <asm filename="src/assets/game-modes/mo6/title/main.asm"/>
                    </lwasm>
                </file>

                <!-- Title - sound player -->
                <!-- ******************************************************* -->
                <file name="engine.object.sound.ymm" linkdata="LINK" region="ymm.player">
                    <lwasm>
                        <asm filename="engine/sound/ymm.asm"/>
                    </lwasm>
                </file>

                <file name="engine.object.sound.vgc" linkdata="LINK" region="vgc.player">
                    <lwasm>
                        <asm filename="engine/sound/vgc.buffers.asm"/>
                        <asm filename="engine/sound/vgc.asm"/>
                    </lwasm>
                </file>

                <!-- Title - sound data -->
                <!-- ******************************************************* -->
                <file name="assets.sounds.title.ymm" linkdata="LINK" region="ymm.data">
                    <lwasm>
                        <label name="sounds.title.ymm"/>
                    </lwasm>
                    <vgm2ymm filename="src/assets/sounds/title/resources/rtype-title.vgm" genbinary="src/assets/sounds/title/music.ymm"/>
                </file>

                <file name="assets.sounds.title.vgc" linkdata="LINK" region="vgc.data">
                    <lwasm>
                        <label name="sounds.title.vgc"/>
                    </lwasm>
                        <vgm2vgc filename="src/assets/sounds/title/resources/rtype-title.vgm" genbinary="src/assets/sounds/title/music.vgc"/>
                </file>

                <!-- Title - sound player dynamic port -->
                <!-- ******************************************************* -->
                <file name="engine.system.mo6.sound.ym.const" linkdata="LINK">
                    <lwasm>
                        <asm filename="engine/system/mo6/sound/ym.2.const.asm"/>
                    </lwasm>
                </file>

                <file name="engine.system.mo6.sound.sn.const" linkdata="LINK">
                    <lwasm>
                        <asm filename="engine/system/mo6/sound/sn.2.const.asm"/>
                    </lwasm>
                </file>

                <!-- Level1 - sound data -->
                <!-- ******************************************************* -->
                <file name="assets.sounds.level1.ymm" linkdata="LINK" region="ymm.data">
                    <lwasm>
                        <label name="sounds.level1.ymm"/>
                    </lwasm>
                    <vgm2ymm filename="src/assets/sounds/level1/resources/rtype-level1.vgm" genbinary="src/assets/sounds/level1/music.ymm"/>
                </file>

                <file name="assets.sounds.level1.vgc" linkdata="LINK" region="vgc.data">
                    <lwasm>
                        <label name="sounds.level1.vgc"/>
                    </lwasm>
                        <vgm2vgc filename="src/assets/sounds/level1/resources/rtype-level1.vgm" genbinary="src/assets/sounds/level1/music.vgc"/>
                </file>

                <!-- Scenes -->
                <!-- ******************************************************* -->
                <scene name="scenes.title" section="SCENE" gensource="gen/scenes/title.asm">
                    <load name="assets.gm.title"/>
                    <load name="engine.object.sound.ymm"/>
                    <load name="engine.object.sound.vgc"/>
                    <load name="assets.sounds.title.ymm"/>
                    <load name="assets.sounds.title.vgc"/>
                    <!-- link data only (export-only files) -->
                    <load name="engine.system.mo6.sound.ym.const"/>
                    <load name="engine.system.mo6.sound.sn.const"/>
                </scene>

                <scene name="scenes.level1" section="SCENE" gensource="gen/scenes/level1.asm">
                    <load name="assets.sounds.level1.ymm"/>
                    <load name="assets.sounds.level1.vgc"/>
                </scene>

            </directory>

            <!-- Boot loader -->
            <!-- *********************************************************** -->
            <define symbol="loader.DEFAULT_DYNAMIC_MEMORY_SIZE" value="$1000"/>

            <define symbol="boot.CHECK_MEMORY_EXT"/>

            <data section="LOADER">
                <lwasm format="raw" gensource="gen/bootloader/loader.asm">
                    <asm filename="gen/directories/disk0/entries.asm"/>
                    <!-- use xml:space="preserve" in asm element when line starts with spaces -->
                    <asm>loader.DEFAULT_SCENE_DIR_ID    equ 0</asm>
                    <asm>loader.DEFAULT_SCENE_EXEC_PAGE equ 1</asm>
                    <asm>loader.DEFAULT_SCENE_EXEC_ADDR equ $2100</asm>
                    <asm>loader.DEFAULT_SCENE_FILE_ID   equ scenes.title</asm>
                    <asm filename="engine/system/mo6/bootloader/loader.asm"/>
                </lwasm>
            </data>

            <data section="BOOT" maxsize="0x100">   
                <cksumfd640>
                    <lwasm format="raw">
                        <asm filename="engine/system/mo6/bootloader/boot.asm"/>
                    </lwasm>
                </cksumfd640>
            </data>

            <fd  filename="mo6.fd"/>
            <sd  filename="mo6.sd"/>
            <sap filename="mo6.sap"/>
            <hfe filename="mo6.hfe"/>
        </floppydisk>
    </target>
</configuration>

