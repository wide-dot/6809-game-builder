     E830             (o8/memory-map.equ):00085         IRQ.EXIT        equ $E830 ; to exit an irq
                      (o8/memory-map.equ):00086         
                      (o8/memory-map.equ):00087         ; system variables
     6019             (o8/memory-map.equ):00088         STATUS          equ $6019 ; status bitfield
     6048             (o8/memory-map.equ):00089         DK.OPC          equ $6048 ; operation
     6049             (o8/memory-map.equ):00090         DK.DRV          equ $6049 ; drive
     604C             (o8/memory-map.equ):00091         DK.SEC          equ $604C ; sector
     604A             (o8/memory-map.equ):00092         DK.TRK          equ $604A ; $604B ; track
     604E             (o8/memory-map.equ):00093         DK.STA          equ $604E ; return status
     604F             (o8/memory-map.equ):00094         DK.BUF          equ $604F ; $6050 ; data write location
     6023             (o8/memory-map.equ):00095         FIRQPT          equ $6023 ; routine firq
     6027             (o8/memory-map.equ):00096         TIMERPT         equ $6027 ; routine irq timer
     6081             (o8/memory-map.equ):00097         CF74021.SYS1.R  equ $6081 ; reading value for CF74021.SYS1
                      (o8/memory-map.equ):00098         
                      (o8/memory-map.equ):00099         ; constants
     0035             (o8/memory-map.equ):00100         EF5860.TXIRQON  equ %00110101 ; 8bits, no parity check, stop 1, tx interrupt
     0015             (o8/memory-map.equ):00101         EF5860.TXIRQOFF equ %00010101 ; 8bits, no parity check, stop 1, no interrupt
     4DFF             (o8/memory-map.equ):00102         IRQ.ONEFRAME    equ 312*64-1  ; one frame timer (lines*cycles_per_lines-1), timer launch at -1
                      (o8/memory-map.equ):00103         
                      (o8/memory-map.equ):00104         ; -----------------------------------------------------------------------------
