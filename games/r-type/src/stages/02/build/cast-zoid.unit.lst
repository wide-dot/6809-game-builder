                      (on/engine/api.asm):00001         ;*******************************************************************************
                      (on/engine/api.asm):00002         ; The engine interface — one list, both sides
                      (on/engine/api.asm):00003         ;
                      (on/engine/api.asm):00004         ; The resident engine unit and every stage unit include this same file. The
                      (on/engine/api.asm):00005         ; engine defines ENGINE_RESIDENT before including it and gets EXPORT lines ;
                      (on/engine/api.asm):00006         ; a stage gets EXTERNAL lines for the same names. The two sides cannot drift,
                      (on/engine/api.asm):00007         ; because there is only one list.
                      (on/engine/api.asm):00008         ;
                      (on/engine/api.asm):00009         ; This is lane 2 of the stage boundary (see
                      (on/engine/api.asm):00010         ; docs/lang/fr/analyse-frontiere-stage-2026-08.md) : what a stage calls in the
                      (on/engine/api.asm):00011         ; engine. Lane 3 — the tables the engine reads back from the stage — is the
                      (on/engine/api.asm):00012         ; other direction and lives in stage-tables.asm.
                      (on/engine/api.asm):00013         ;
                      (on/engine/api.asm):00014         ; Adding a name here costs four bytes of link data in the engine's direntry and
                      (on/engine/api.asm):00015         ; a linear search per reference at load time, so the list stays deliberately
                      (on/engine/api.asm):00016         ; short : the engine offers mechanisms, the stage holds the policy.
                      (on/engine/api.asm):00017         ;*******************************************************************************
                      (on/engine/api.asm):00018         
                      (on/engine/api.asm):00019         ; Garde d'inclusion. Une unite classique n'inclut ce fichier qu'une fois, mais
                      (on/engine/api.asm):00020         ; un membre de PAGESET porte plusieurs blocs qui l'incluent chacun : sans garde,
                      (on/engine/api.asm):00021         ; le second redefinit le macro _api. Un en-tete doit pouvoir etre inclus deux
                      (on/engine/api.asm):00022         ; fois — c'est vrai independamment du pageset.
                      (on/engine/api.asm):00023          IFNDEF ENGINE_API_INCLUDED
     0001             (on/engine/api.asm):00024         ENGINE_API_INCLUDED equ 1
                      (on/engine/api.asm):00025         
0000                  (on/engine/api.asm):00026         _api    macro
                      (on/engine/api.asm):00027           ifdef ENGINE_RESIDENT
0000                  (on/engine/api.asm):00028         \1 EXPORT
                      (on/engine/api.asm):00029           else
0000                  (on/engine/api.asm):00030         \1 EXTERNAL
                      (on/engine/api.asm):00031           endif
                      (on/engine/api.asm):00032                 endm
                      (on/engine/api.asm):00033         
                      (on/engine/api.asm):00034                 ; --- boot and frame ---
