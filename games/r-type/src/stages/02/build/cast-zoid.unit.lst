                      (engine/macros.asm):00112                 ; param 2 : Object routine
                      (engine/macros.asm):00113                 ; manual launch of an object from the resident page 1
                      (engine/macros.asm):00114                 ; this object does not need or have a data structure for this routine
                      (engine/macros.asm):00115                 _MountObject \1
                      (engine/macros.asm):00116                 ldb   \2        
                      (engine/macros.asm):00117                 jsr   ,x
                      (engine/macros.asm):00118          ENDM
                      (engine/macros.asm):00119         
