                      (es_properties.asm):00114         ; Gouger (stage 2). Boite arcade 1000:31ee : ee ff 12 00 ee ff 12 00, soit
                      (es_properties.asm):00115         ; -18..+18 sur les deux axes — un RAYON de 18. A l'echelle du fichier
                      (es_properties.asm):00116         ; (x 0.375 en X, x 0.75 en Y) : 18 x 0.375 = 6.75 -> 7, 18 x 0.75 = 13.5 -> 14.
                      (es_properties.asm):00117         ; Les PV viennent du spawner (40:6fb2), qui ecrase la table de difficulte par
                      (es_properties.asm):00118         ; un $0A inconditionnel.
     0007             (es_properties.asm):00119         gouger_hitbox_x equ 7
     000E             (es_properties.asm):00120         gouger_hitbox_y equ 14
     000A             (es_properties.asm):00121         gouger_hitdamage        equ 10
                      (es_properties.asm):00122         
                      (es_properties.asm):00123         ; Brood (stage 2). Boites arcade 1000:3846, DIFFERENTES par orientation et
                      (es_properties.asm):00124         ; ASYMETRIQUES : plafond x -24..+24 y -16..+32, sol x -24..+24 y -32..+16.
                      (es_properties.asm):00125         ; L'axe Y arcade monte, donc le corps est du cote de la paroi dans les deux
                      (es_properties.asm):00126         ; cas. Demi-etendues a l'echelle du fichier : 24 x 0,375 = 9 en X,
                      (es_properties.asm):00127         ; 24 x 0,75 = 18 en Y. Le centre, lui, est decale de 8 arcade = 6 v2, vers le
                      (es_properties.asm):00128         ; haut au plafond et vers le bas au sol — c'est le code objet qui le pose sur
                      (es_properties.asm):00129         ; cy, notre AABB n'ayant pas d'excentrage.
                      (es_properties.asm):00130         ; 40 PV (0x28), score $8700.
     0009             (es_properties.asm):00131         brood_hitbox_x          equ 9
     0012             (es_properties.asm):00132         brood_hitbox_y          equ 18
     0028             (es_properties.asm):00133         brood_hitdamage         equ 40
     0006             (es_properties.asm):00134         brood_cy_offset         equ 6
                      (es_properties.asm):00135         
                      (es_properties.asm):00136         ; Zoid (stage 2), le parasite que le brood crache. Boite 1000:3f6e.
                      (es_properties.asm):00137         ; 4 PV a l'eclosion (0x04) ; l'oeuf et l'eclosion sont invulnerables — l'oeuf
                      (es_properties.asm):00138         ; eclot au premier coup au lieu d'encaisser, l'eclosion jette le resultat.
     0004             (es_properties.asm):00139         zoid_hitbox_x           equ 4
     0008             (es_properties.asm):00140         zoid_hitbox_y           equ 8
     0004             (es_properties.asm):00141         zoid_hitdamage          equ 4
                      (es_properties.asm):00142         
                      (es_properties.asm):00143         ; Wick (stage 2). Boite arcade 1000:3c12 : f8 ff 08 00 des deux cotes, soit
                      (es_properties.asm):00144         ; -8..+8 — un RAYON de 8. A l'echelle du fichier : 8 x 0,375 = 3 en X et
                      (es_properties.asm):00145         ; 8 x 0,75 = 6 en Y. Il meurt au premier coup, d'ou 1 PV ; son score est le
                      (es_properties.asm):00146         ; plus bas de la table arcade ($86E8), ce que wick_scoreIdx = 0 dit deja.
     0003             (es_properties.asm):00147         wick_hitbox_x           equ 3
     0006             (es_properties.asm):00148         wick_hitbox_y           equ 6
     0001             (es_properties.asm):00149         wick_hitdamage          equ 1
                      (es_properties.asm):00150         
                      (es_properties.asm):00151         ; Outslay (stage 2). Boite arcade 1000:427c : 16x16 centree, soit 8 px de
                      (es_properties.asm):00152         ; demi-cote -> 8 x 0.375 = 3 en X et 8 x 0.75 = 6 en Y... mais l'arcade
                      (es_properties.asm):00153         ; compte en pixels arcade et la boite v2 en pixels larges : la demi-largeur
                      (es_properties.asm):00154         ; utile est celle du sprite (12x24 large-dot), d'ou 6 et 12.
                      (es_properties.asm):00155         ; Seul le CORPS est vulnerable et il meurt au premier coup (933c zerote
                      (es_properties.asm):00156         ; [+0x1f] a l'install et body_tick ne le rearme jamais) ; tete, cou, queue,
                      (es_properties.asm):00157         ; finalizer et cadavre reappliquent l'immunite a chaque trame (929b/929f).
                      (es_properties.asm):00158         ; Gomander (boss du stage 2). L'arcade teste la boite de l'ORBE, son point
                      (es_properties.asm):00159         ; faible : les 8 premiers octets de gomander_orb_sprite_offsets (1000:54ea)
                      (es_properties.asm):00160         ; donnent -16..+16 en X et -8..+8 en Y, arcade -> 16*0.375 = 6 et 8*0.75 = 6.
                      (es_properties.asm):00161         ; 8 PV (a256), mais UN coup par exposition : voir gomander/obj.asm.
     0006             (es_properties.asm):00162         gomander_hitbox_x       equ 6
     0006             (es_properties.asm):00163         gomander_hitbox_y       equ 6
     0008             (es_properties.asm):00164         gomander_hitdamage      equ 8
                      (es_properties.asm):00165         
     0006             (es_properties.asm):00166         outslay_hitbox_x        equ 6
     000C             (es_properties.asm):00167         outslay_hitbox_y        equ 12
     0001             (es_properties.asm):00168         outslay_hitdamage       equ 1
     FF80             (es_properties.asm):00169         outslay_hitdamage_immune equ -128
                      (es_properties.asm):00170         
                      (es_properties.asm):00171         ; slither (stage 5). Les TROIS boites arcade sont centrees et donnent des
                      (es_properties.asm):00172         ; DEMI-extensions : 1000:37c6 pour la tete (f0 ff 10 00 = -16..+16 sur les
                      (es_properties.asm):00173         ; deux axes, donc rayon 16), 1000:37ce pour un corps et 1000:37d6 pour la
                      (es_properties.asm):00174         ; queue (f6 ff 0a 00 = rayon 10 ; les deux tables sont numeriquement
                      (es_properties.asm):00175         ; identiques, d'ou une seule paire d'equates ici).
                      (es_properties.asm):00176         ; Echelle du fichier : rayon arcade x 0.375 en X, x 0.75 en Y — la meme que
                      (es_properties.asm):00177         ; tabrok, gomander et outslay_shot.
                      (es_properties.asm):00178         ;   corps/queue : 10 x 0.375 = 3.75 -> 4   |  10 x 0.75 = 7.5 -> 8
                      (es_properties.asm):00179         ;   tete        : 16 x 0.375 = 6           |  16 x 0.75  = 12
                      (es_properties.asm):00180         ; CORRECTION 25/08/2026 : ces quatre valeurs etaient le DOUBLE (8/15 et
                      (es_properties.asm):00181         ; 12/24). L'echelle etait juste mais appliquee a la taille PLEINE, alors que
                      (es_properties.asm):00182         ; l'en-tete de ce fichier definit hitbox_x/y comme des RAYONS — le serpent
                      (es_properties.asm):00183         ; etait deux fois trop facile a toucher, surtout verticalement.
                      (es_properties.asm):00184         ; Pas d'exception a la Outslay ici : celle-la elargit sciemment la boite a la
                      (es_properties.asm):00185         ; demi-largeur du sprite large-dot (voir plus haut), on reste ici fidele a
                      (es_properties.asm):00186         ; l'arcade comme demande.
                      (es_properties.asm):00187         ; Le hitdamage porte les PV, que la passe de collision decremente :
                      (es_properties.asm):00188         ; 0x0E (14) pour la tete d'apres head_ctor, 6 pour le corps et la queue.
     0004             (es_properties.asm):00189         slither_hitbox_x        equ 4
     0008             (es_properties.asm):00190         slither_hitbox_y        equ 8
     0006             (es_properties.asm):00191         slither_hitdamage       equ 6
     0006             (es_properties.asm):00192         slither_head_hitbox_x   equ 6
     000C             (es_properties.asm):00193         slither_head_hitbox_y   equ 12
     000E             (es_properties.asm):00194         slither_head_hitdamage  equ 14
                      (es_properties.asm):00195         
                      (es_properties.asm):00196         ; Le bydo shot de la salve en etoile. Sa boite est la SIENNE (1000:4196,
                      (es_properties.asm):00197         ; fc ff 04 00 fc ff 04 00 = rayon 4 sur les deux axes), le double du bullet
                      (es_properties.asm):00198         ; commun (1000:84c6, rayon 2) qu'on lui pretait jusqu'ici.
                      (es_properties.asm):00199         ; 4 x 0.375 = 1.5 -> 2 en X, 4 x 0.75 = 3 en Y.
     0002             (es_properties.asm):00200         outslay_shot_hitbox_x   equ 2
     0003             (es_properties.asm):00201         outslay_shot_hitbox_y   equ 3
     0001             (es_properties.asm):00202         outslay_shot_hitdamage  equ 1
                      (es_properties.asm):00203         
                      (es_properties.asm):00204         ; --- HP set inline in the obj (centralised here for the stage-1 catalogue) ---
                      (es_properties.asm):00205         ; Arcade-verified via doc/arcade-combat-reference.md (section 4 roster).
     0006             (es_properties.asm):00206         p_staff_hitdamage         equ 6      ; arcade create_p_staff @0x74b4 : +0x2F = 6 (v2)
     001E             (es_properties.asm):00207         scant_hitdamage           equ $1e    ; arcade : +0x2F = 30 (v2) ; arcade St.7, reused St.1
                      (es_properties.asm):00208         ; Shell : corps maintenu invincible ($80 = -128) jusqu'a l'ancrage de progression ;
                      (es_properties.asm):00209         ;   le vrai kill = le coeur bleu expose. Logique speciale dans shell/obj.asm
                      (es_properties.asm):00210         ;   (invincible_full_potential + potential_set), pas un simple PV initial.
                      (es_properties.asm):00211         
                      (es_properties.asm):00212          ENDC
                      (ast-zoid.unit.asm):00035                 INCLUDE "src/common/fx/explosion/explosion.const.asm"
                      (plosion.const.asm):00001         ; Garde d'inclusion : un membre de PAGESET porte plusieurs blocs qui
                      (plosion.const.asm):00002         ; incluent chacun cet en-tete. Un en-tete doit pouvoir etre inclus deux
                      (plosion.const.asm):00003         ; fois — c'est vrai independamment du pageset.
                      (plosion.const.asm):00004          IFNDEF EXPLOSION_CONST
     0001             (plosion.const.asm):00005         EXPLOSION_CONST equ 1
                      (plosion.const.asm):00006         
                      (plosion.const.asm):00007         
     0000             (plosion.const.asm):00008         explosion.subtype.smallx3 equ 0
     0002             (plosion.const.asm):00009         explosion.subtype.smallx2 equ 2
     0004             (plosion.const.asm):00010         explosion.subtype.fwk     equ 4
     0006             (plosion.const.asm):00011         explosion.subtype.mid     equ 6
     0008             (plosion.const.asm):00012         explosion.subtype.big     equ 8
     000A             (plosion.const.asm):00013         explosion.subtype.big.blue equ 10
     000C             (plosion.const.asm):00014         explosion.subtype.big.brown equ 12
     000E             (plosion.const.asm):00015         explosion.subtype.smallx3.erase equ 14
                      (plosion.const.asm):00016         
                      (plosion.const.asm):00017          ENDC
                      (ast-zoid.unit.asm):00036                 INCLUDE "src/common/state/variables.asm"
                      (ate/variables.asm):00001          IFNDEF GLOBAL_VARIABLES
                      (ate/variables.asm):00002         
                      (ate/variables.asm):00003         ; V2-DEVIATION: l'ancre passe de $9E84 a $9E80. En v1 elle etait DERIVEE — le
                      (ate/variables.asm):00004         ; premier octet libre apres un main qui finissait en $9E80 — donc elle n'avait
                      (ate/variables.asm):00005         ; pas de valeur propre. En v2 le contenu resident s'arrete bien plus bas et
                      (ate/variables.asm):00006         ; l'ancre est un choix de layout : $9E80 donne un bloc reserve de $80 pile, et
                      (ate/variables.asm):00007         ; il se retient. Les temoins du banc partagent ce bloc (bench.const.asm).
     9DCB             (ate/variables.asm):00008         GLOBAL_VARIABLES         equ $9DCB ; ancre du bloc reserve `globals` ($9DCB-$9E5E)
                      (ate/variables.asm):00009                                            ; = GLOBALS_BASE (ram.const.asm) = layout —
                      (ate/variables.asm):00010                                            ; les trois bougent ENSEMBLE (2026-08-10 :
                      (ate/variables.asm):00011                                            ; -117 pour agrandir la pile, pool 45 -> 44)
     9DCB             (ate/variables.asm):00012         globals.nextGameMode     equ GLOBAL_VARIABLES+0 ; 1 byte
     9DCC             (ate/variables.asm):00013         globals.score            equ GLOBAL_VARIABLES+1 ; 3 bytes (24-bit, unit=100pts, MSB first; cap 99999=$01869F)
     9DCF             (ate/variables.asm):00014         globals.lives            equ GLOBAL_VARIABLES+4 ; 1 byte
     9DD0             (ate/variables.asm):00015         globals.backgroundSolid  equ GLOBAL_VARIABLES+5 ; 1 byte
     9DD1             (ate/variables.asm):00016         globals.difficulty       equ GLOBAL_VARIABLES+6 ; 1 byte
     9DD2             (ate/variables.asm):00017         globals.lifeUpIdx        equ GLOBAL_VARIABLES+7 ; 1 byte
     9DD3             (ate/variables.asm):00018         globals.bossDefeated     equ GLOBAL_VARIABLES+8 ; 1 byte
     9DD4             (ate/variables.asm):00019         globals.stageScoreBase   equ GLOBAL_VARIABLES+9 ; 3 bytes (score at stage start)
                      (ate/variables.asm):00020         ; --- arme missile joueur : STATUT D'ARME persistant (doit survivre au changement de stage) ---
     9DD7             (ate/variables.asm):00021         globals.missileUnlocked  equ GLOBAL_VARIABLES+12 ; 1 byte (1 = missile débloqué par le bonus)
                      (ate/variables.asm):00022         
                      (ate/variables.asm):00023         * LA TRAINEE DU JOUEUR : 32 positions (x,y) sur 4 octets, que le force pod
                      (ate/variables.asm):00024         * relit avec 30 trames de retard pour le suivre en revenant au vaisseau.
                      (ate/variables.asm):00025         *
                      (ate/variables.asm):00026         * Elle vivait dans la page du JOUEUR tant qu'il etait seul a la lire. Le force
                      (ate/variables.asm):00027         * pod vit dans SA page : quand il tourne, celle du joueur n'est pas montee, et
                      (ate/variables.asm):00028         * deux etiquettes dans deux pages ne sont pas la meme variable — exactement ce
                      (ate/variables.asm):00029         * que globals.missileUnlocked a deja enseigne. Elle rejoint donc la zone
                      (ate/variables.asm):00030         * reservee, ou la v1 la met aussi (ram_data.asm du game mode).
                      (ate/variables.asm):00031         *
                      (ate/variables.asm):00032         * PIEGE : la v1 initialise le pointeur DEPUIS SON BINAIRE (`fdb
                      (ate/variables.asm):00033         * player_pos_ring_buffer`). Un bloc <reserved> n'est ni charge ni mis a zero :
                      (ate/variables.asm):00034         * le corps commun du stage doit le semer a l'ouverture, comme il seme les OST
                      (ate/variables.asm):00035         * statiques. Cf. docs/lang/en/migration/reserved-ram-is-not-zeroed.md
     9DD8             (ate/variables.asm):00036         player_pos_ring_buffer     equ GLOBAL_VARIABLES+13  ; 4*32 = 128 octets
     9E58             (ate/variables.asm):00037         player_pos_ring_buffer_ptr equ GLOBAL_VARIABLES+141 ; 2 octets
                      (ate/variables.asm):00038         
                      (ate/variables.asm):00039         * L'etat du gestionnaire de missiles. Il vivait dans la page du JOUEUR, seul a
                      (ate/variables.asm):00040         * le lire — et la note d'a cote disait de le ranger dans la RAM du stage. Les
                      (ate/variables.asm):00041         * deux sont perimees depuis que le missile est porte : il est COMMUN (page du
                      (ate/variables.asm):00042         * cast, partagee par tous les stages) et il decompte le meme compteur que le
                      (ate/variables.asm):00043         * joueur incremente. Deux etiquettes dans deux pages ne sont pas la meme
                      (ate/variables.asm):00044         * variable — meme lecon que globals.missileUnlocked et la trainee du joueur.
                      (ate/variables.asm):00045         *
                      (ate/variables.asm):00046         * Le bloc reserve n'est ni charge ni mis a zero : c'est l'Init du joueur qui
                      (ate/variables.asm):00047         * seme les trois, comme la v1 (player1.asm).
     9E5A             (ate/variables.asm):00048         missilePairCount           equ GLOBAL_VARIABLES+143 ; 1 octet, missiles vivants
     9E5B             (ate/variables.asm):00049         missileTgtTop              equ GLOBAL_VARIABLES+144 ; 2 octets, OST cible du haut
     9E5D             (ate/variables.asm):00050         missileTgtBot              equ GLOBAL_VARIABLES+146 ; 2 octets, OST cible du bas
                      (ate/variables.asm):00051         
                      (ate/variables.asm):00052         * LE CROCHET DE COUCHE DESTRUCTIBLE (24/08/2026).
                      (ate/variables.asm):00053         *
                      (ate/variables.asm):00054         * Un stage peut porter une couche de decor que les tirs du joueur DETRUISENT —
                      (ate/variables.asm):00055         * le champ de gommes du stage 4 aujourd'hui. Le code d'arme, lui, est COMMUN :
                      (ate/variables.asm):00056         * il est charge une fois au boot et sert les huit stages, donc il ne peut pas
                      (ate/variables.asm):00057         * referencer un symbole qui n'existe que sur l'un d'eux (le lien se resoudrait
                      (ate/variables.asm):00058         * a zero sur les sept autres, et le premier tir sauterait dans le vide).
                      (ate/variables.asm):00059         *
                      (ate/variables.asm):00060         * D'ou ce vecteur : le corps commun du stage le pose sur le neutre, le stage
                      (ate/variables.asm):00061         * qui a une couche destructible le pointe sur LE SIEN. Il designe une table de
                      (ate/variables.asm):00062         * deux `jmp`, a la maniere de terrainCollision.unit :
                      (ate/variables.asm):00063         *
                      (ate/variables.asm):00064         *   +0  EFFACER    [x] = x de carte, [b] = ligne ecran
                      (ate/variables.asm):00065         *                  rend Z=0 si quelque chose a ete detruit.
                      (ate/variables.asm):00066         *                  `jsr [stage.gum.hook]` tombe dessus tel quel.
                      (ate/variables.asm):00067         *   +3  CHERCHER   le senseur terrainCollision est deja pose par l'appelant
                      (ate/variables.asm):00068         *                  rend D = le x de carte de la premiere cellule destructible
                      (ate/variables.asm):00069         *                  a DROITE du senseur, 0 si aucune.
                      (ate/variables.asm):00070         *                  `ldx stage.gum.hook / jsr 3,x`
                      (ate/variables.asm):00071         *   +6  RECTANGLE  [x] = le coin haut-gauche du bloc au DEPART (x de carte),
                      (ate/variables.asm):00072         *                  [y] = le meme x a l'ARRIVEE,
                      (ate/variables.asm):00073         *                  [b] = la ligne ecran du haut,
                      (ate/variables.asm):00074         *                  [a] = la taille du bloc, quartet HAUT = largeur, BAS =
                      (ate/variables.asm):00075         *                        hauteur, en cellules ($12 = le beam, $44 = le pod).
                      (ate/variables.asm):00076         *                  Efface la surface BALAYEE par le bloc entre les deux points.
                      (ate/variables.asm):00077         *                  Les bords sont rabotes au champ, pas refuses.
                      (ate/variables.asm):00078         *                  Pour une arme qui CREUSE au lieu de mourir sur la premiere
                      (ate/variables.asm):00079         *                  cellule. Le depart et l'arrivee sont ce qui rend la
                      (ate/variables.asm):00080         *                  compensation de trames gratuite : la reunion des passes
                      (ate/variables.asm):00081         *                  d'une trame est un seul rectangle, quel qu'en soit le
                      (ate/variables.asm):00082         *                  nombre.
                      (ate/variables.asm):00083         *
                      (ate/variables.asm):00084         * POURQUOI DEUX ENTREES (25/08/2026). Sonder a la position courante une fois
                      (ate/variables.asm):00085         * par trame ne marche pas a bas regime : le tir simple avance de 6*frameDrop
                      (ate/variables.asm):00086         * d'un coup — 24 px a 12 img/s, huit cellules — donc il enjambe des gommes et
                      (ate/variables.asm):00087         * mange celle sur laquelle il retombe, loin devant son sprite d'impact. La
                      (ate/variables.asm):00088         * recherche resout ca comme le mur l'est deja depuis la v1 : UN balayage a la
                      (ate/variables.asm):00089         * naissance donne le point d'arrivee au pixel, et il ne depend plus du regime.
     9E5F             (ate/variables.asm):00090         stage.gum.hook             equ GLOBAL_VARIABLES+148 ; 2 octets, vecteur
                      (ate/variables.asm):00091         
                      (ate/variables.asm):00092         * L'ARMEMENT DU JOUEUR — CE QUE LA PARTIE POSSEDE (25/08/2026).
                      (ate/variables.asm):00093         *
                      (ate/variables.asm):00094         * Ces cinq octets vivaient dans `player1+ext_variables`, donc dans la PAGE
                      (ate/variables.asm):00095         * DIRECTE — et la page directe est balayee DEUX FOIS a chaque entree de stage
                      (ate/variables.asm):00096         * (InitGlobals, puis ObjectDp_Clear via checkpoint.load). Le joueur perdait
                      (ate/variables.asm):00097         * donc pod, bits, vitesse et missiles en passant d'un niveau au suivant, alors
                      (ate/variables.asm):00098         * que la borne les conserve : la seule chose qu'on y perd, c'est en mourant.
                      (ate/variables.asm):00099         *
                      (ate/variables.asm):00100         * Ils rejoignent le bloc reserve pour la meme raison que
                      (ate/variables.asm):00101         * globals.missileUnlocked juste au-dessus, dont le commentaire disait deja
                      (ate/variables.asm):00102         * « STATUT D'ARME persistant (doit survivre au changement de stage) » — les
                      (ate/variables.asm):00103         * quatre autres n'avaient simplement jamais suivi. Une seule copie de la
                      (ate/variables.asm):00104         * verite, et plus aucun effaceur ne passe dessus.
                      (ate/variables.asm):00105         *
                      (ate/variables.asm):00106         * CE QUI RESTE DANS L'OST DU JOUEUR : beam_value (la charge se perd, comme en
                      (ate/variables.asm):00107         * arcade), forcepod_attached et forcepod_mount_side — de l'etat COURANT du
                      (ate/variables.asm):00108         * pod, pas de la propriete. Comme sur la borne, le pod reste ou il est pendant
                      (ate/variables.asm):00109         * la sequence de fin ; c'est l'entree du stage suivant qui le remet accroche
                      (ate/variables.asm):00110         * (decision auteur, 25/08/2026 : un rappel avait ete essaye, il rendait mal a
                      (ate/variables.asm):00111         * l'ecran). Accroche, sa position se rederive du vaisseau a chaque trame — il
                      (ate/variables.asm):00112         * n'y a donc rien a conserver de son etat courant.
                      (ate/variables.asm):00113         *
                      (ate/variables.asm):00114         * LE BLOC RESERVE N'EST NI CHARGE NI MIS A ZERO : c'est le semis de partie
                      (ate/variables.asm):00115         * fraiche qui les efface, et la mort qui les reprend — voir
                      (ate/variables.asm):00116         * checkpoint.armament dans src/common/flow/checkpoint.unit.asm : c'est
                      (ate/variables.asm):00117         * checkpoint.reload — la porte de la MORT — qui les reprend, la ou
                      (ate/variables.asm):00118         * checkpoint.load, l'ouverture d'un stage, les rend.
     9E61             (ate/variables.asm):00119         globals.forcepodlevel      equ GLOBAL_VARIABLES+150 ; 1 octet, 0 a 3 (0 = pas de pod)
     9E62             (ate/variables.asm):00120         globals.forcepodtype       equ GLOBAL_VARIABLES+151 ; 1 octet, = player_one_laser_type arcade
     9E63             (ate/variables.asm):00121         globals.bitdevice          equ GLOBAL_VARIABLES+152 ; 1 octet, nombre de bit devices (0, 1 ou 2)
     9E64             (ate/variables.asm):00122         globals.speedlevel         equ GLOBAL_VARIABLES+153 ; 2 octets, offset dans la table speed.preset
     0005             (ate/variables.asm):00123         globals.ARMAMENT_SIZE      equ 5                    ; ce que checkpoint.armament efface
                      (ate/variables.asm):00124         
                      (ate/variables.asm):00125          ENDC
                      (ast-zoid.unit.asm):00037                 INCLUDE "src/common/lib/scale.asm"
                      (mon/lib/scale.asm):00001         ; Garde d'inclusion : un membre de PAGESET porte plusieurs blocs qui
                      (mon/lib/scale.asm):00002         ; incluent chacun cet en-tete. Un en-tete doit pouvoir etre inclus deux
                      (mon/lib/scale.asm):00003         ; fois — c'est vrai independamment du pageset.
                      (mon/lib/scale.asm):00004          IFNDEF SCALE_CONST
     0001             (mon/lib/scale.asm):00005         SCALE_CONST equ 1
                      (mon/lib/scale.asm):00006         
     FFA0             (mon/lib/scale.asm):00007         scale.XN1PX equ -$0060 ; x:-0.375
     0060             (mon/lib/scale.asm):00008         scale.XP1PX equ $0060  ; x:+0.375
     FF40             (mon/lib/scale.asm):00009         scale.YN1PX equ -$00C0 ; y:-0.75
     00C0             (mon/lib/scale.asm):00010         scale.YP1PX equ $00C0  ; y:+0.75
                      (mon/lib/scale.asm):00011         
