     003D             (ine/constants.asm):00349         rsv_priority_next_obj         equ object_rsvd+3 ; and +4 ; next object (OST address) in display priority list for video buffer 0 (0000 if none) w
                      (ine/constants.asm):00350         
                      (ine/constants.asm):00351         ; ---------------------------------------------------------------------------
                      (ine/constants.asm):00352         ; when childsprites are activated (i.e. bit #6 of render_flags set)
