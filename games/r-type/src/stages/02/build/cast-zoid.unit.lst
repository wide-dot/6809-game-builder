                      (engine/macros.asm):00086                 lda   Obj_Index_Page+\1
                      (engine/macros.asm):00087                 _SetCartPageA
                      (engine/macros.asm):00088                 ldx   Obj_Index_Address+2*\1
                      (engine/macros.asm):00089          ENDM
                      (engine/macros.asm):00090         
0000                  (engine/macros.asm):00091         _RunObject MACRO 
                      (engine/macros.asm):00092                 ; param 1 : ObjID_
                      (engine/macros.asm):00093                 ; param 2 : Object data RAM address
                      (engine/macros.asm):00094                 ; manual launch of an object from the resident page 1
                      (engine/macros.asm):00095                 _MountObject \1
                      (engine/macros.asm):00096                 ldu   \2        
                      (engine/macros.asm):00097                 jsr   ,x
                      (engine/macros.asm):00098          ENDM
                      (engine/macros.asm):00099         
0000                  (engine/macros.asm):00100         _RunObjectRoutineA MACRO 
                      (engine/macros.asm):00101                 ; param 1 : ObjID_
                      (engine/macros.asm):00102                 ; param 2 : Object routine
                      (engine/macros.asm):00103                 ; manual launch of an object from the resident page 1
                      (engine/macros.asm):00104                 ; this object does not need or have a data structure for this routine
                      (engine/macros.asm):00105                 _MountObject \1
                      (engine/macros.asm):00106                 lda   \2        
                      (engine/macros.asm):00107                 jsr   ,x
                      (engine/macros.asm):00108          ENDM
                      (engine/macros.asm):00109         
0000                  (engine/macros.asm):00110         _RunObjectRoutineB MACRO 
