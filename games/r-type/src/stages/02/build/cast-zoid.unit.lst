0000                  (ine/constants.asm):00195         render_xmirror_mask           equ $01 ; (bit 0) DEPENDENCY should be bit 0 - tell display engine to mirror sprite on horizontal axis
0000                  (ine/constants.asm):00196         render_ymirror_mask           equ $02 ; (bit 1) DEPENDENCY should be bit 1 - tell display engine to mirror sprite on vertical axis
0000                  (ine/constants.asm):00197         render_overlay_mask           equ $04 ; (bit 2) DEPENDENCY should be bit 2 - compilated sprite with no background save
0000                  (ine/constants.asm):00198         render_playfieldcoord_mask    equ $08 ; (bit 3) tell display engine to use playfield (1) or screen (0) coordinates
0000                  (ine/constants.asm):00199         render_xloop_mask             equ $10 ; (bit 4) (in screen coordinate) tell display engine to hide sprite when x is out of screen (0) or to display (1)  
0000                  (ine/constants.asm):00200         render_todelete_mask          equ $20 ; (bit 5) tell display engine to delete sprite and clear OST for this object
0000                  (ine/constants.asm):00201         render_subobjects_mask        equ $40 ; (bit 6) tell display engine to render subobjects for this object
0000                  (ine/constants.asm):00202         render_hide_mask              equ $80 ; (bit 7) tell display engine to hide sprite (keep priority and mapping_frame)
                      (ine/constants.asm):00203          else
