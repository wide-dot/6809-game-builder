0000                  (engine/macros.asm):00059         _RunObjectSwap MACRO
                      (engine/macros.asm):00060                 ; param 1 : ObjID_
                      (engine/macros.asm):00061                 ; param 2 : Object data RAM address
                      (engine/macros.asm):00062                 ; manual launch of an object from a different dynamic memory page and not from the resident page 1
                      (engine/macros.asm):00063                 lda   Obj_Index_Page+\1
                      (engine/macros.asm):00064                 sta   PSR_Page   
                      (engine/macros.asm):00065                 ldd   Obj_Index_Address+2*\1
                      (engine/macros.asm):00066                 std   PSR_Address       
                      (engine/macros.asm):00067                 ldu   \2             
                      (engine/macros.asm):00068                 jsr   RunPgSubRoutine
                      (engine/macros.asm):00069          ENDM    
                      (engine/macros.asm):00070         
0000                  (engine/macros.asm):00071         _RunObjectSwapRoutine MACRO
                      (engine/macros.asm):00072                 ; param 1 : ObjID_
                      (engine/macros.asm):00073                 ; param 2 : Object routine
                      (engine/macros.asm):00074                 ; manual launch of an object from a different dynamic memory page and not from the resident page 1
                      (engine/macros.asm):00075                 lda   Obj_Index_Page+\1   
                      (engine/macros.asm):00076                 sta   PSR_Page   
                      (engine/macros.asm):00077                 ldd   Obj_Index_Address+2*\1
                      (engine/macros.asm):00078                 std   PSR_Address       
                      (engine/macros.asm):00079                 ldb   \2        
                      (engine/macros.asm):00080                 jsr   RunPgSubRoutine
