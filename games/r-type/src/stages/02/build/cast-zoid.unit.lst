                      (ine/constants.asm):00036         ; WARNING - BuildSprite allow to cross $A000 limit by glb_camera_x_offset/4
                      (ine/constants.asm):00037         ; Graphics routines using S to write may cross by 12 bytes
                      (ine/constants.asm):00038         ; be sure to compile with enough margin here
     9FF4             (ine/constants.asm):00039         glb_ram_end                   equ $A000-12
                      (ine/constants.asm):00040         
                      (ine/constants.asm):00041         ; compilated sprite
     9FF2             (ine/constants.asm):00042         glb_register_s                equ glb_ram_end-2             ; reverved space to store S from ROM routines
                      (ine/constants.asm):00043         
                      (ine/constants.asm):00044         ; DrawSprites
     9FF0             (ine/constants.asm):00045         glb_screen_location_1         equ glb_register_s-2          ; start address for rendering of current sprite Part1     
     9FEE             (ine/constants.asm):00046         glb_screen_location_2         equ glb_screen_location_1-2   ; start address for rendering of current sprite Part2 (DEPENDENCY Must follow Part1)
                      (ine/constants.asm):00047         
     9FEC             (ine/constants.asm):00048         glb_camera_height             equ glb_screen_location_2-2
     9FEA             (ine/constants.asm):00049         glb_camera_width              equ glb_camera_height-2
     9FE8             (ine/constants.asm):00050         glb_camera_x_pos_coarse       equ glb_camera_width-2        ; ((glb_camera_x_pos - 64) / 64) * 64
     9FE6             (ine/constants.asm):00051         glb_camera_x_pos              equ glb_camera_x_pos_coarse-2 ; 16.8 camera x position in palyfield coordinates
     9FE5             (ine/constants.asm):00052         glb_camera_x_sub              equ glb_camera_x_pos-1        ; 
     9FE4             (ine/constants.asm):00053         glb_camera_y_pos              equ glb_camera_x_pos-2        ; 16.8 camera y position in palyfield coordinates
     9FE3             (ine/constants.asm):00054         glb_camera_y_sub              equ glb_camera_y_pos-1        ;
     9FE2             (ine/constants.asm):00055         glb_camera_x_min_pos          equ glb_camera_y_pos-2
     9FE0             (ine/constants.asm):00056         glb_camera_y_min_pos          equ glb_camera_x_min_pos-2
     9FDE             (ine/constants.asm):00057         glb_camera_x_max_pos          equ glb_camera_y_min_pos-2
     9FDC             (ine/constants.asm):00058         glb_camera_y_max_pos          equ glb_camera_x_max_pos-2
     9FDA             (ine/constants.asm):00059         glb_camera_x_offset           equ glb_camera_y_max_pos-2
     9FD8             (ine/constants.asm):00060         glb_camera_y_offset           equ glb_camera_x_offset-2
     9FD7             (ine/constants.asm):00061         glb_force_sprite_refresh      equ glb_camera_y_offset-1
     9FD6             (ine/constants.asm):00062         glb_camera_move               equ glb_force_sprite_refresh-1
     9FD5             (ine/constants.asm):00063         glb_alphaTiles                equ glb_camera_move-1
     9FD4             (ine/constants.asm):00064         glb_timer_second              equ glb_alphaTiles-1
     9FD3             (ine/constants.asm):00065         glb_timer_minute              equ glb_timer_second-1
     9FD3             (ine/constants.asm):00066         glb_timer                     equ glb_timer_minute
     9FD2             (ine/constants.asm):00067         glb_timer_frame               equ glb_timer-1
                      (ine/constants.asm):00068         
                      (ine/constants.asm):00069         ; BankSwitch
     9FD1             (ine/constants.asm):00070         glb_Page                      equ glb_timer_frame-1
     9FB3             (ine/constants.asm):00071         dp_engine                     equ glb_Page-30  ; engine routines tmp var space
     9F97             (ine/constants.asm):00072         dp_extreg                     equ dp_engine-28 ; extra register space (user and engine common)
     9F00             (ine/constants.asm):00073         dp                            equ $9F00        ; user space (149 bytes max)
     9EF0             (ine/constants.asm):00074         glb_system_stack              equ dp-16 ; the log block owns dp-16..dp-1
                      (ine/constants.asm):00075                                                  ; ($9EF0-$9EFF, engine/log/log.const.asm) :
                      (ine/constants.asm):00076                                                  ; the stack tops right below it
                      (ine/constants.asm):00077         
                      (ine/constants.asm):00078         ; generic direct page extra registers
                      (ine/constants.asm):00079         ; -----------------------------------
     9F97             (ine/constants.asm):00080         glb_d0   equ   dp_extreg
