                      (ast-zoid.unit.asm):00038                 INCLUDE "src/common/fx/animation/index.equ"
                      (imation/index.equ):00001         ; Garde d'inclusion : un membre de PAGESET porte plusieurs blocs qui
                      (imation/index.equ):00002         ; incluent chacun cet en-tete. Un en-tete doit pouvoir etre inclus deux
                      (imation/index.equ):00003         ; fois — c'est vrai independamment du pageset.
                      (imation/index.equ):00004          IFNDEF ANIM_INDEX_EQU
     0001             (imation/index.equ):00005         ANIM_INDEX_EQU equ 1
                      (imation/index.equ):00006         
     0000             (imation/index.equ):00007         anim_192EC    equ   0  ; bug
     0020             (imation/index.equ):00008         anim_19A96    equ   32 ; pow
     0022             (imation/index.equ):00009         anim_19AA2    equ   34 ; pow
     0024             (imation/index.equ):00010         anim_19AB2    equ   36 ; pow
     0026             (imation/index.equ):00011         anim_19ACE    equ   38 ; pata pata
     0028             (imation/index.equ):00012         anim_19AF8    equ   40 ; bink (jump left)
     002A             (imation/index.equ):00013         anim_19B0A    equ   42 ; bink (jump right)
     002C             (imation/index.equ):00014         anim_1A652    equ   44 ; outslay (variante 4 du spawn, stage 2)
     002E             (imation/index.equ):00015         anim_1A4E6    equ   46 ; outslay variante 0 (combat gomander)
     0030             (imation/index.equ):00016         anim_1A530    equ   48 ; outslay variante 1 (combat gomander)
     0032             (imation/index.equ):00017         anim_1A56E    equ   50 ; outslay variante 2 (combat gomander)
     0034             (imation/index.equ):00018         anim_1A626    equ   52 ; outslay variante 3 (combat gomander)
                      (imation/index.equ):00019         ; cytron : les seize variantes du quartet haut du subtype, treize scripts
                      (imation/index.equ):00020         ; distincts (12..15 partagent le dernier). Voir movescript.asm.
     0036             (imation/index.equ):00021         anim_19D32    equ   54 ; cytron variante 0
     0038             (imation/index.equ):00022         anim_19D68    equ   56 ; cytron variante 1
     003A             (imation/index.equ):00023         anim_19DA4    equ   58 ; cytron variante 2
     003C             (imation/index.equ):00024         anim_19E0A    equ   60 ; cytron variante 3
     003E             (imation/index.equ):00025         anim_19E4E    equ   62 ; cytron variante 4
     0040             (imation/index.equ):00026         anim_19EF8    equ   64 ; cytron variante 5
     0042             (imation/index.equ):00027         anim_19F2E    equ   66 ; cytron variante 6
     0044             (imation/index.equ):00028         anim_19F7C    equ   68 ; cytron variante 7
     0046             (imation/index.equ):00029         anim_19FBC    equ   70 ; cytron variante 8
     0048             (imation/index.equ):00030         anim_19FDE    equ   72 ; cytron variante 9
     004A             (imation/index.equ):00031         anim_1A000    equ   74 ; cytron variante 10
     004C             (imation/index.equ):00032         anim_1A046    equ   76 ; cytron variante 11
     004E             (imation/index.equ):00033         anim_1A086    equ   78 ; cytron variantes 12 a 15
                      (imation/index.equ):00034         ; Le slither prend SEIZE entrees contiguës : le quartet haut du descripteur
                      (imation/index.equ):00035         ; de wave choisit la variante, l'init calcule base + quartet*2. Les scripts
                      (imation/index.equ):00036         ; eux-memes etaient DEJA dans le pool commun (script.asm) — seule la table
                      (imation/index.equ):00037         ; d'index leur manquait, soit 32 octets.
                      (imation/index.equ):00038         ; Il vient APRES le cytron : les deux ont ete ajoutes a l'offset 54 sur des
                      (imation/index.equ):00039         ; branches paralleles, et le cytron occupe 54..78.
     0050             (imation/index.equ):00040         anim_slither  equ   80 ; slither, base des seize variantes (stage 5)
                      (imation/index.equ):00041         ; Les DEUX scripts de vol libre du cadavre (40:7b85 en choisit un selon la
                      (imation/index.equ):00042         ; pose : < 9 -> 1000:A3E6, sinon 1000:A380). Ils etaient deja dans le pool
                      (imation/index.equ):00043         ; commun, comme les seize variantes — seules les deux lignes d'index
                      (imation/index.equ):00044         ; manquaient. Contigus et dans CET ordre : l'init du cadavre fait
                      (imation/index.equ):00045         ; base + 2 si la pose est haute.
     0070             (imation/index.equ):00046         anim_slither_corpse equ 112 ; slither, vol libre du cadavre (stage 5)
                      (imation/index.equ):00047         ; L'oeuf de zoid ne vole pas droit : le brood choisit sa liste de segments par
                      (imation/index.equ):00048         ; (orientation, creneau de ponte), d'ou SIX entrees contigues — les trois
                      (imation/index.equ):00049         ; premieres pour un brood de plafond, les trois suivantes pour un de sol.
                      (imation/index.equ):00050         ; L'init de l'oeuf fait base + orientation*6 + creneau*2.
                      (imation/index.equ):00051         ; Les scripts etaient DEJA dans le pool commun (script.asm, ref_1A434 et
                      (imation/index.equ):00052         ; suivants) : seules ces six lignes d'index manquaient. J'avais commence a
                      (imation/index.equ):00053         ; les re-extraire de la ROM — inutile, tout le pool arcade est importe.
                      (imation/index.equ):00054         ; (114 d'abord — faux : le cadavre du slither occupe 112 ET 114, ses DEUX
                      (imation/index.equ):00055         ; entrees comptent. La base du zoid est le rang suivant.)
     0074             (imation/index.equ):00056         anim_zoid     equ 116 ; zoid, base des six listes de ponte (stage 2)
                      (imation/index.equ):00057         
                      (imation/index.equ):00058          ENDC
                      (ast-zoid.unit.asm):00039         
                      (ast-zoid.unit.asm):00040                 INCLUDE "src/enemies/zoid/zoid.equ"
                      (ies/zoid/zoid.equ):00001         ; L'etat du zoid dans son OST — partage entre son implementation et la ponte
                      (ies/zoid/zoid.equ):00002         ; du brood (brood.Egg seme deux graines ici avant le premier tick). Le zoid
                      (ies/zoid/zoid.equ):00003         ; vit dans SON unite (stage2.cast.zoid) : la page du cast etait pleine, et il
                      (ies/zoid/zoid.equ):00004         ; n'a aucun couplage de label avec les autres — seules ces equates franchissent
                      (ies/zoid/zoid.equ):00005         ; la frontiere, et une equate ne se lie pas, elle s'assemble.
     0026             (ies/zoid/zoid.equ):00006         zoid.AABB       equ ext_variables      ; 0..8  la boite
     002F             (ies/zoid/zoid.equ):00007         zoid.lock       equ ext_variables+9    ; 9     verrou : le PROCHAIN cap vise le joueur
     0030             (ies/zoid/zoid.equ):00008         zoid.freeze     equ ext_variables+10   ; 10    pose figee pendant le recul (+0x38)
     0031             (ies/zoid/zoid.equ):00009         zoid.count      equ ext_variables+11   ; 11    compteur de phase — la ponte y laisse
                      (ies/zoid/zoid.equ):00010                                                ;       l'index de script pour l'init
     0032             (ies/zoid/zoid.equ):00011         zoid.anim       equ ext_variables+12   ; 12    accumulateur de pose — la ponte y
                      (ies/zoid/zoid.equ):00012                                                ;       laisse le retard de naissance
     0033             (ies/zoid/zoid.equ):00013         zoid.lastP      equ ext_variables+13   ; 13    dernier potentiel vu (detection de coup)
                      (ast-zoid.unit.asm):00041                 INCLUDE "src/enemies/zoid/obj.asm"
                      (mies/zoid/obj.asm):00001         ;*******************************************************************************
                      (mies/zoid/obj.asm):00002         ; zoid — le parasite pondu par le brood, trois phases et DEUX ANCRAGES
                      (mies/zoid/obj.asm):00003         ;
                      (mies/zoid/obj.asm):00004         ; FICHE DE PORTAGE (base Ghidra `maincpu`, subsystem brood/zoid)
                      (mies/zoid/obj.asm):00005         ; -------------------------------------------------------------------------
                      (mies/zoid/obj.asm):00006         ;   40:8058 create_zoid ............ la ponte (implementee dans brood.Egg)
                      (mies/zoid/obj.asm):00007         ;   40:8d85 run_zoid_egg ........... l'oeuf, vole sur un script, suit le decor
                      (mies/zoid/obj.asm):00008         ;   40:8dc6 run_zoid_hatch ......... l'eclosion, 31 trames, immobile A L'ECRAN
                      (mies/zoid/obj.asm):00009         ;   40:8e15 run_zoid_parasite ...... le rodage, ancre ecran, vitesse 8.8
                      (mies/zoid/obj.asm):00010         ;   40:8efa zoid_retarget .......... le choix de cap (table de 16 ou joueur)
                      (mies/zoid/obj.asm):00011         ;   40:8ecc zoid_recoil_on_hit ..... le recul au coup encaisse
                      (mies/zoid/obj.asm):00012         ;   40:8e86 zoid_killed_by_player .. mort : score 0x86F8, explosion e7be
                      (mies/zoid/obj.asm):00013         ;   1000:3ee6 les seize destinations de rodage (positions d'ECRAN)
                      (mies/zoid/obj.asm):00014         ;   1000:3f6e la boite (+-10 x +-10 arcade -> rayons 4 et 8)
                      (mies/zoid/obj.asm):00015         ;
                      (mies/zoid/obj.asm):00016         ; L'OEUF. Ne a la position du parent (80c2/80c8), il vole sur une liste de
                      (mies/zoid/obj.asm):00017         ; segments moveByScript choisie par (orientation du brood, creneau de ponte)
                      (mies/zoid/obj.asm):00018         ; — six listes contigues a anim_zoid dans la LUT commune, TROIS commandes de
                      (mies/zoid/obj.asm):00019         ; script par trame (80be : MOV byte ptr [SI+0x17],0x3 — la plate Ghidra
                      (mies/zoid/obj.asm):00020         ; l'appelle « HP », c'est la vitesse d'interprete, le +0x17 de move_by_script).
                      (mies/zoid/obj.asm):00021         ; Il suit le decor (le tick applique 0x2ED0) : chez nous repere PLAYFIELD,
                      (mies/zoid/obj.asm):00022         ; c'est-a-dire AUCUN code — la logique d'ancrage est inversee entre les deux
                      (mies/zoid/obj.asm):00023         ; moteurs. Quatre poses tenues quatre trames, sur compteur libre.
                      (mies/zoid/obj.asm):00024         ; Il eclot a la FIN DU SCRIPT ou au PREMIER COUP encaisse (8dbb), le premier
                      (mies/zoid/obj.asm):00025         ; des deux ; le coup se lit sur AABB.p : toute entaille fait eclore.
                      (mies/zoid/obj.asm):00026         ;
                      (mies/zoid/obj.asm):00027         ; L'ECLOSION. 31 trames (+0x26 := $1F), pose = bits 3-4 du compte a rebours
                      (mies/zoid/obj.asm):00028         ; (elle descend 3,2,1,0). IMMOBILE A L'ECRAN : le tick 8dc6 n'applique PLUS
                      (mies/zoid/obj.asm):00029         ; 0x2ED0 — c'est ICI que l'ancrage bascule, pas a la fin de l'eclosion.
                      (mies/zoid/obj.asm):00030         ; x_pos/y_pos deviennent des accumulateurs 8.8 d'ecran (entier en octet
                      (mies/zoid/obj.asm):00031         ; haut), render_flags passe a zero. Invulnerable : le resultat de la
                      (mies/zoid/obj.asm):00032         ; collision est JETE (8dfa) — AABB.p est reposee a chaque trame, le contact
                      (mies/zoid/obj.asm):00033         ; blesse toujours le joueur. A la fin : 4 PV (8e08), verrou vierge, et
                      (mies/zoid/obj.asm):00034         ; +0x26 := 1 — il rode DES la trame suivante.
                      (mies/zoid/obj.asm):00035         ;
                      (mies/zoid/obj.asm):00036         ; LE RODAGE (8e15 + 8efa). Compte a rebours de 128 trames ; a l'echeance,
                      (mies/zoid/obj.asm):00037         ; nouveau cap : 75 % vers l'une des seize destinations d'ECRAN de 1000:3ee6,
                      (mies/zoid/obj.asm):00038         ; et une fois sur quatre un verrou s'arme pour que le PROCHAIN cap vise le
                      (mies/zoid/obj.asm):00039         ; joueur (verrou a un coup, il ne colle jamais). La vitesse est
                      (mies/zoid/obj.asm):00040         ; delta << 1 en 8.8 — soit delta/128 par trame : il ARRIVE quand le compte
                      (mies/zoid/obj.asm):00041         ; expire. La formule est invariante d'echelle, elle se recopie telle quelle
                      (mies/zoid/obj.asm):00042         ; en coordonnees v2. Quatre poses tenues huit trames.
                      (mies/zoid/obj.asm):00043         ;
                      (mies/zoid/obj.asm):00044         ; LE RECUL (8ecc). vx := 0 dans les deux cas. Le seuil arcade y >= 0xB0
                      (mies/zoid/obj.asm):00045         ; (v2 : y <= 165, l'axe arcade monte — les presets du brood le prouvent,
                      (mies/zoid/obj.asm):00046         ; plafond 368 -> 21) : repousse vers le BAS de 3 px arcade/trame (v2 +2,25,
                      (mies/zoid/obj.asm):00047         ; $0240), pose FIGEE (+0x38), fenetre (y_arc - 0xB0)/2 + 1 trames — en v2
                      (mies/zoid/obj.asm):00048         ; (165 - y) x 2/3 + 1, approchee par x171/256. Sous le seuil (pres du sol) :
                      (mies/zoid/obj.asm):00049         ; pas de recul, cap recalcule a la trame suivante. La plate Ghidra lit ce
                      (mies/zoid/obj.asm):00050         ; recul avec l'axe inverse (« knock upward ») ; les octets et les presets
                      (mies/zoid/obj.asm):00051         ; tranchent, le geste repousse vers le bas, loin du plafond.
                      (mies/zoid/obj.asm):00052         ;
                      (mies/zoid/obj.asm):00053         ; CONVERSIONS. Destinations et seuils par la formule de la table :
                      (mies/zoid/obj.asm):00054         ; x = (x_arc - 320) x 0,375 + 8, y = 297 - 0,75 x y_arc, repere ecran 0-base
                      (mies/zoid/obj.asm):00055         ; (l'octet x_pixel/y_pixel recoit +screen_left/+screen_top au dessin).
                      (mies/zoid/obj.asm):00056         ; FIX #1 : la destination 2 (352,144) convertit en y = 189, dont le bas de
                      (mies/zoid/obj.asm):00057         ; sprite (189+11) depasse la ligne 199 et ferait rejeter le dessin en bloc —
                      (mies/zoid/obj.asm):00058         ; ecretee a 188, un demi-pixel arcade.
                      (mies/zoid/obj.asm):00059         ;
                      (mies/zoid/obj.asm):00060         ; ABANDONNE (meme arbitrage que le brood) : les sons (0x5D ponte, 0x57 coup,
                      (mies/zoid/obj.asm):00061         ; 0x52 mort), le clignotement de coup par palette d'objet (0x55), et
                      (mies/zoid/obj.asm):00062         ; l'escalade de PV du second loop (8e08 : 70 PV si [0x2F2D] — pas de second
                      (mies/zoid/obj.asm):00063         ; loop chez nous).
                      (mies/zoid/obj.asm):00064         ;*******************************************************************************
                      (mies/zoid/obj.asm):00065         ; -----------------------------------------------------------------------------
                      (mies/zoid/obj.asm):00066         ; L'ETAT : dans zoid.equ — la ponte du brood, dans l'AUTRE unite, seme deux
                      (mies/zoid/obj.asm):00067         ; graines dans ces champs.
                      (mies/zoid/obj.asm):00068         ; -----------------------------------------------------------------------------
     00A5             (mies/zoid/obj.asm):00069         zoid.RECOILY    equ 165                ; arcade $B0 : la frontiere du recul
     0240             (mies/zoid/obj.asm):00070         zoid.RECOILVY   equ $0240              ; arcade -3 px/trame -> v2 +2,25 vers le bas
                      (mies/zoid/obj.asm):00071         
