0000                  (engine/macros.asm):00201         _waitFrames MACRO
                      (engine/macros.asm):00202                lda   \1
0000                  (engine/macros.asm):00203         @l1    tst   $E7E7 ; beam is not in the screen
                      (engine/macros.asm):00204                bpl   @l1   ; until the bit is 0 loop
0000                  (engine/macros.asm):00205         @l2    tst   $E7E7 ; beam is in the screen
                      (engine/macros.asm):00206                bmi   @l2   ; until the bit is 1 loop
