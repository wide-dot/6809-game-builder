     6049             (ine/constants.asm):00026         dk_drive                      equ $6049
     604A             (ine/constants.asm):00027         dk_track                      equ $604A
     604B             (ine/constants.asm):00028         dk_track_lsb                  equ $604B
     604C             (ine/constants.asm):00029         dk_sector                     equ $604C
     604F             (ine/constants.asm):00030         dk_write_location             equ $604F
                      (ine/constants.asm):00031         
