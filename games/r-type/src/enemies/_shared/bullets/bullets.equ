; Les constantes du manager de tirs — voir mgr.asm pour le pourquoi.
 IFNDEF BULLETS_EQU
BULLETS_EQU equ 1

; La structure AABB : les offsets de boite des slots en derivent. Son en-tete
; porte sa propre garde de double inclusion — concu pour etre inclus partout.
        INCLUDE "engine/collision/struct_AABB.equ"

; COMBIEN DE BALLES A LA FOIS. Chaque slot coute 21 octets dans la page du
; manager, la ou une balle-objet coutait 117 octets de pool — un rapport de
; cinq et demi, et surtout des octets qui ne sont plus pris aux ennemis. 24
; laisse de la marge au-dela de ce que l'arcade met a l'ecran, pour 504 octets.
bullet.SLOTS    equ 24
bullet.SLOTSZ   equ 21

; L'ENVELOPPE DU SPRITE, CUITE. Le manager blitte des poses compilees fixes
; (adr_foefire_*_ND0) sans imageset : la geometrie que CheckSpritesRefresh
; irait chercher dans image_subset_y1_offset et image_y_size est ici une
; constante, ce qui evite deux lectures indexees par balle et par trame.
;
; Mesuree sur les QUATRE poses et leurs DEUX plans (gen/weapons/foefire/
; foefire_*_ND0.asm) : 48 STA, toutes a un offset multiple de 40, de -80 a
; +120 depuis U. Donc deux lignes au-dessus de l'ancre, trois au-dessous, et
; UNE SEULE colonne d'octet — le sprite fait 3x6 pixels. A remesurer si l'art
; change : tools/sprite_envelope.py le fait et compare a ces valeurs.
bullet.DRAW_UP    equ 2            ; lignes ecrites AU-DESSUS de l'ancre
bullet.DRAW_DOWN  equ 3            ; lignes ecrites AU-DESSOUS
bullet.DRAW_RIGHT equ 1            ; octets a droite de l'ancre (le plan 1 est
                                   ; a +$2001 quand DRS_XYToAddress passe par
                                   ; RAM2First : un octet plus loin)

; LES BORNES DE DESSIN, en coordonnee de balle — DRS_XYToAddress retranche
; screen_top, donc la ligne de buffer EST bullet.y. Un plan fait 200 lignes ;
; ecrire hors de ces bornes sort du buffer, et sous $A000 on tombe sur la
; queue de la page directe, ou vit glb_camera_y_pos (le vaisseau disparaissait
; ainsi : camera corrompue, CheckRange recopiant l'ordure dans player1+y_pos).
bullet.YMIN     equ bullet.DRAW_UP
bullet.YMAX     equ screen_height-1-bullet.DRAW_DOWN
; en x, le sprite tient dans sa colonne : il suffit de retirer la largeur
; d'un octet (4 px en coordonnee ecran) pour que le plan decale ne deborde
; pas sur la ligne suivante — c'est le bouclage en x que le moteur interdit.
bullet.XMAX     equ screen_right-screen_left-4*bullet.DRAW_RIGHT

; La table vit en RAM RESIDENTE (<reserved objects.bullets>, demi-page 0) —
; les boites AABB qu'elle porte sont parcourues par Collision_Do avec la page
; de collisionpass montee, elles ne peuvent pas vivre en page montee. Le
; BATTEMENT et le temps mort y vivent AUSSI : le rechargement de checkpoint
; (resident) doit pouvoir les perimer sans monter la page du manager.
bullet.Slots    equ objects.bullets.address
bullet.beat     equ bullet.Slots+bullet.SLOTS*bullet.SLOTSZ
bullet.idle     equ bullet.beat+2
; LE SENTINEL « MORT ». Un battement a zero ne veut PAS dire mort : les
; horloges de trame REPARTENT A ZERO a l'entree d'un stage, et « 0 » y est
; un battement frais — au stage 4 les premiers tirs tombent avant la trame
; 256 et s'armaient sans manager (personne ne les fait vivre), puis la
; premiere vraie naissance wipait une table deja chainee : liste circulaire
; (gel du 30/08/2026). Collision_ClearLists pose CE sentinel, et bullet.Arm
; fait naitre le manager des qu'il le voit — la fenetre n'existe plus.
bullet.DEAD     equ $FFFF

; Un slot : la boite du moteur puis l'etat de la balle.
bullet.AABB     equ 0
bullet.used     equ 9
bullet.delay    equ 10
bullet.x        equ 11
bullet.y        equ 14
bullet.vx       equ 17
bullet.vy       equ 19
; Les quatre trames invisibles du tir de la tourelle multiple (arcade dc99).
bullet.MULTIDELAY equ 4
bullet.RADIUS   equ 2                  ; le rayon de boite de la balle-objet

; L'AGE MAXIMAL DU BATTEMENT, en trames video : au-dela, le manager est repute
; mort et le prochain tir en fait naitre un. Comme il ne se retire plus jamais
; de lui-meme, seule une PURGE ou un CHANGEMENT DE STAGE peut le faire
; disparaitre — 256 trames (cinq secondes) sont donc largement au-dessus de
; tout intervalle normal entre deux de ses tours, et il n'y a plus aucun risque
; d'en faire naitre un second alors que le premier vit.
bullet.BEAT     equ 256
; Le manager ne se retire plus (voir mgr.asm) : il n'a plus de temps mort.

 ENDC
