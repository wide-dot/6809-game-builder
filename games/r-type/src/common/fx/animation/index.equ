; Garde d'inclusion : un membre de PAGESET porte plusieurs blocs qui
; incluent chacun cet en-tete. Un en-tete doit pouvoir etre inclus deux
; fois — c'est vrai independamment du pageset.
 IFNDEF ANIM_INDEX_EQU
ANIM_INDEX_EQU equ 1

anim_192EC    equ   0  ; bug
anim_19A96    equ   32 ; pow
anim_19AA2    equ   34 ; pow
anim_19AB2    equ   36 ; pow
anim_19ACE    equ   38 ; pata pata
anim_19AF8    equ   40 ; bink (jump left)
anim_19B0A    equ   42 ; bink (jump right)
anim_1A652    equ   44 ; outslay (variante 4 du spawn, stage 2)
anim_1A4E6    equ   46 ; outslay variante 0 (combat gomander)
anim_1A530    equ   48 ; outslay variante 1 (combat gomander)
anim_1A56E    equ   50 ; outslay variante 2 (combat gomander)
anim_1A626    equ   52 ; outslay variante 3 (combat gomander)
; cytron : les seize variantes du quartet haut du subtype, treize scripts
; distincts (12..15 partagent le dernier). Voir movescript.asm.
anim_19D32    equ   54 ; cytron variante 0
anim_19D68    equ   56 ; cytron variante 1
anim_19DA4    equ   58 ; cytron variante 2
anim_19E0A    equ   60 ; cytron variante 3
anim_19E4E    equ   62 ; cytron variante 4
anim_19EF8    equ   64 ; cytron variante 5
anim_19F2E    equ   66 ; cytron variante 6
anim_19F7C    equ   68 ; cytron variante 7
anim_19FBC    equ   70 ; cytron variante 8
anim_19FDE    equ   72 ; cytron variante 9
anim_1A000    equ   74 ; cytron variante 10
anim_1A046    equ   76 ; cytron variante 11
anim_1A086    equ   78 ; cytron variantes 12 a 15
; Le slither prend SEIZE entrees contiguës : le quartet haut du descripteur
; de wave choisit la variante, l'init calcule base + quartet*2. Les scripts
; eux-memes etaient DEJA dans le pool commun (script.asm) — seule la table
; d'index leur manquait, soit 32 octets.
; Il vient APRES le cytron : les deux ont ete ajoutes a l'offset 54 sur des
; branches paralleles, et le cytron occupe 54..78.
anim_slither  equ   80 ; slither, base des seize variantes (stage 5)
; Les DEUX scripts de vol libre du cadavre (40:7b85 en choisit un selon la
; pose : < 9 -> 1000:A3E6, sinon 1000:A380). Ils etaient deja dans le pool
; commun, comme les seize variantes — seules les deux lignes d'index
; manquaient. Contigus et dans CET ordre : l'init du cadavre fait
; base + 2 si la pose est haute.
anim_slither_corpse equ 112 ; slither, vol libre du cadavre (stage 5)

 ENDC
