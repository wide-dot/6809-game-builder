; Garde d'inclusion : un membre de PAGESET porte plusieurs blocs qui
; incluent chacun cet en-tete. Un en-tete doit pouvoir etre inclus deux
; fois — c'est vrai independamment du pageset.
 IFNDEF PLAYER1_EQU
PLAYER1_EQU equ 1

        
p1_AABB_0           equ ext_variables     ; AABB struct (9 bytes)
beam_value          equ ext_variables+9   ; 1 byte (0-60)
is_charging         equ ext_variables+10  ; 1 byte (0 or anything else)
; +11 a +15 : LIBRES. C'etaient forcepodlevel, forcepodtype, bitdevice et
; speedlevel — l'ARMEMENT, parti dans le bloc `globals` le 25/08/2026 parce
; que la page directe est balayee a chaque entree de stage et que le joueur y
; perdait tout en changeant de niveau. Voir src/common/state/variables.asm.
; La taille de l'OST ne bouge pas : la retailler deplacerait le pool et les
; OST statiques, pour cinq octets qui ne manquent a personne.
forcepod_attached   equ ext_variables+16  ; 1 byte (0: no, 1:yes)
forcepod_mount_side equ ext_variables+17  ; 1 byte (0: front, 1:rear)

 ENDC
