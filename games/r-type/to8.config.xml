<configuration>
    <target name="fd">
        <default name="floppydisk.storage" value="engine/config/storage.xml"/>

        <!-- La carte mémoire dit la frontière de chargement.                  -->
        <!--                                                                   -->
        <!-- 'common' est chargée une fois au boot et plus jamais : elle porte -->
        <!-- le moteur et l'état qui doit survivre aux changements de stage.   -->
        <!--                                                                   -->
        <!-- 'stage' et les deux régions de tuiles sont déclarées interface :   -->
        <!-- les unités qui s'y chargent sont des alternatives, mutuellement   -->
        <!-- exclusives au runtime. Le builder les autorise donc à exporter    -->
        <!-- les mêmes noms, et exige d'elles la même liste d'exports.         -->
        <layout gensymbols="gen/layout.asm">
            <region name="common"     page="$01" address="$6100" size="$2200"/>
            <region name="stage"      page="$01" address="$8300" size="$0D00" interface="true"/>
            <!-- Le niveau 1 entier : 244 tuiles paires et 303 impaires, soit -->
            <!-- bien plus qu'une page. On declare un budget, le pageset range. -->
            <region name="tiles.even" page="$06" address="$0000" size="$4000" pages="3" interface="true"/>
            <region name="tiles.odd"  page="$09" address="$0000" size="$4000" pages="5" interface="true"/>
            <!-- Les tables de carte : 132x15 cases sur deux plans font 11880  -->
            <!-- octets, hors de portee de la RAM residente. Elles vivent donc  -->
            <!-- dans une page a elles, ce que le scroll sait faire — il porte  -->
            <!-- deja une page par plan de carte.                               -->
            <region name="maps"       page="$0E" address="$0000" size="$4000" interface="true"/>
            <!-- Les scripts d'animation : communs a tous les objets et a tous -->
            <!-- les stages, charges une fois — mais pagines, AnimateSprite      -->
            <!-- montant la page avant de lire.                                 -->
            <region name="anim"       page="$0F" address="$0000" size="$4000"/>
            <!-- Les ennemis : code et images dans la meme page, comme en v1 —  -->
            <!-- RunObjects monte la page avant d'appeler l'objet, et l'index   -->
            <!-- d'imageset y lit la geometrie des sprites.                     -->
            <region name="enemies"    page="$05" address="$0000" size="$4000"/>

            <!-- Ce que le jeu occupe sans jamais rien y charger. Le builder ne -->
            <!-- peut pas le deviner — ce sont des equates du code — donc on le  -->
            <!-- declare, et il refuse d'y faire atterrir quoi que ce soit.      -->
            <!--                                                                -->
            <!-- $9E84 est la limite haute d'un main : au-dessus vivent les     -->
            <!-- variables inter-main, puis la pile, puis la page directe en    -->
            <!-- $9F00. La pile a donc un budget FIXE, et la zone DP est        -->
            <!-- protegee comme le reste.                                       -->
            <reserved name="objects.pool" page="$01" address="$90B0" size="$0750"/>
            <reserved name="bench.wit"    page="$01" address="$9C00" size="$0284"/>
            <reserved name="globals"      page="$01" address="$9E84" size="$007C"/>
            <reserved name="stack"        page="$01" address="$9F00" size="$0100"/>
        </layout>

        <floppydisk model="fd640">

            <!-- Le moteur, lui, a de vraies données de lien : son interface   -->
            <!-- de stage. Les cartes n'en ont aucune (sections .static), donc  -->
            <!-- une piste suffit largement à LINK.                             -->
            <section name="SCENE" track="0" face="1" sector="16"/>
            <section name="LINK"  track="1" face="0" sector="1"/>
            <section name="DATA"  track="3" face="0" sector="1"/>

            <directory id="0" section="INDEX" gensymbols="gen/directories/disk0/entries.asm">
                <default name="direntry.section" value="DATA"/>
                <default name="direntry.maxsize" value="0x4000"/>
                <default name="lwasm.format"     value="obj"/>

                <define symbol="loader.PAGE" value="4"/>
                <define symbol="loader.ADDRESS" value="$A000"/>

                <!-- Le moteur résident                                        -->
                <!-- ******************************************************** -->
                <direntry name="common.engine" codec="zx0" loadtimelink="LINK">
                    <lwasm gensource="gen/common/engine.asm">
                        <asm filename="gen/directories/disk0/entries.asm"/>
                        <asm filename="src/common/engine/engine.asm"/>
                    </lwasm>
                </direntry>

                <!-- Les scripts d'animation, communs. Section .static : leurs  -->
                <!-- ~2900 pointeurs internes sont cuits au build contre le     -->
                <!-- placement declare, donc zero donnee de lien.               -->
                <direntry name="common.anim" codec="zx0" loadtimelink="LINK">
                    <lwasm gensource="gen/common/anim.asm">
                        <asm filename="src/common/fx/animation/anim.asm"/>
                    </lwasm>
                </direntry>

                <!-- Les ennemis. Leurs images d'abord dans le meme direntry :   -->
                <!-- l'index d'imageset resout leur page par <file>$PAGE.        -->
                <direntry name="common.enemies" loadtimelink="LINK">
                    <lwasm gensource="gen/enemies/enemies.asm">
                        <asm filename="gen/directories/disk0/entries.asm"/>
                        <asm filename="src/enemies/pata-pata/enemy.asm"/>
                        <gfxcomp gendir="gen/enemies/pata-pata"
                                 gensource="gen/enemies/pata-pata/includes.asm"
                                 genindex="gen/enemies/pata-pata/index.asm"
                                 file="common.enemies">
                            <image name="patapata_0" filename="src/enemies/pata-pata/images/pata_0.png" index="0">
                                <encoder name="bdraw" mirror="none" shift="0"/>
                            </image>
                            <image name="patapata_1" filename="src/enemies/pata-pata/images/pata_1.png" index="1">
                                <encoder name="bdraw" mirror="none" shift="0"/>
                            </image>
                            <image name="patapata_2" filename="src/enemies/pata-pata/images/pata_2.png" index="2">
                                <encoder name="bdraw" mirror="none" shift="0"/>
                            </image>
                            <image name="patapata_3" filename="src/enemies/pata-pata/images/pata_3.png" index="3">
                                <encoder name="bdraw" mirror="none" shift="0"/>
                            </image>
                            <image name="patapata_4" filename="src/enemies/pata-pata/images/pata_4.png" index="4">
                                <encoder name="bdraw" mirror="none" shift="0"/>
                            </image>
                            <image name="patapata_5" filename="src/enemies/pata-pata/images/pata_5.png" index="5">
                                <encoder name="bdraw" mirror="none" shift="0"/>
                            </image>
                            <image name="patapata_6" filename="src/enemies/pata-pata/images/pata_6.png" index="6">
                                <encoder name="bdraw" mirror="none" shift="0"/>
                            </image>
                            <image name="patapata_7" filename="src/enemies/pata-pata/images/pata_7.png" index="7">
                                <encoder name="bdraw" mirror="none" shift="0"/>
                            </image>
                        </gfxcomp>
                    </lwasm>
                </direntry>

                <!-- Stage 1 : tuiles d'abord, le stage ensuite.               -->
                <!--                                                           -->
                <!-- L'ordre compte. Les tables de carte du stage sont cuites   -->
                <!-- au build contre le placement de SES tuiles : le           -->
                <!-- fournisseur doit être déclaré avant son consommateur, et  -->
                <!-- entre deux alternatives c'est la dernière déclarée qui     -->
                <!-- fournit. D'où le groupement par stage plutôt que par type. -->
                <!-- ******************************************************** -->
                <!-- Le tileset pair ne rentre pas forcement dans une page :   -->
                <!-- on declare un budget de pages et un contenu, le builder    -->
                <!-- mesure, range et emet un direntry par page. L'auteur       -->
                <!-- n'affecte jamais une tuile a une page.                     -->
                <pageset name="stage1.tiles.even" region="tiles.even"
                         gendir="gen/stages/01/tiles-even" loadtimelink="LINK">
                    <gfxcomp gendir="gen/stages/01/tiles-even"
                             gensource="gen/stages/01/tiles-even/includes.asm">
                        <image name="tilesEven" filename="src/stages/01/map/intro/even.png" grid="12x12">
                            <encoder name="draw" mirror="none" shift="0"/>
                        </image>
                    </gfxcomp>
                </pageset>

                <pageset name="stage1.tiles.odd" region="tiles.odd"
                         gendir="gen/stages/01/tiles-odd" loadtimelink="LINK"
                         gensymbols="gen/stages/01/pages.asm">
                    <gfxcomp gendir="gen/stages/01/tiles-odd"
                             gensource="gen/stages/01/tiles-odd/includes.asm">
                        <image name="tilesOdd" filename="src/stages/01/map/intro/odd.png" grid="12x12">
                            <encoder name="draw" mirror="none" shift="0"/>
                        </image>
                    </gfxcomp>
                    <!-- La queue du dernier tileset ne se perd pas : la wave du -->
                    <!-- stage la comble. Elle est deja lue par page montee      -->
                    <!-- (object_wave_data_page), donc rien a adapter cote code. -->
                    <block name="stage1.wave" symbol="stage.wave">
                        <asm filename="src/stages/01/objid.const.asm"/>
                        <asm filename="src/stages/01/wave.asm"/>
                    </block>
                </pageset>

                <!-- Les deux tables de carte, dans leur page                  -->
                <direntry name="stage1.maps" loadtimelink="LINK">
                    <lwasm gensource="gen/stages/01/stage1-maps.asm">
                        <asm filename="engine/system/to8/map.const.asm"/>
                        <tilemap map="src/stages/01/map/intro/even.bin" label="map.even"
                                 tiles="tilesEven" variant="ND0"
                                 gensource="gen/stages/01/map-even.asm"/>
                        <tilemap map="src/stages/01/map/intro/odd.bin" label="map.odd"
                                 tiles="tilesOdd" variant="ND0"
                                 gensource="gen/stages/01/map-odd.asm"/>
                    </lwasm>
                </direntry>

                <direntry name="stage1" codec="zx0" loadtimelink="LINK">
                    <lwasm gensource="gen/stages/01/stage01-main.asm">
                        <asm filename="gen/directories/disk0/entries.asm"/>
                        <asm filename="src/stages/01/main.asm"/>
                        <png2pal symbol="Pal_stage" filename="src/stages/01/map/intro/even.png"/>
                    </lwasm>
                </direntry>

                <!-- Stage 2 : mêmes noms, tout autre contenu                  -->
                <!-- ******************************************************** -->
                <pageset name="stage2.tiles.even" region="tiles.even"
                         gendir="gen/stages/02/tiles-even" loadtimelink="LINK">
                    <gfxcomp gendir="gen/stages/02/tiles-even"
                             gensource="gen/stages/02/tiles-even/includes.asm">
                        <image name="tilesEven" filename="src/stages/02/map/intro/even.png" grid="12x12">
                            <encoder name="draw" mirror="none" shift="0"/>
                        </image>
                    </gfxcomp>
                </pageset>

                <pageset name="stage2.tiles.odd" region="tiles.odd"
                         gendir="gen/stages/02/tiles-odd" loadtimelink="LINK"
                         gensymbols="gen/stages/02/pages.asm">
                    <gfxcomp gendir="gen/stages/02/tiles-odd"
                             gensource="gen/stages/02/tiles-odd/includes.asm">
                        <image name="tilesOdd" filename="src/stages/02/map/intro/odd.png" grid="12x12">
                            <encoder name="draw" mirror="none" shift="0"/>
                        </image>
                    </gfxcomp>
                    <!-- La queue du dernier tileset ne se perd pas : la wave du -->
                    <!-- stage la comble. Elle est deja lue par page montee      -->
                    <!-- (object_wave_data_page), donc rien a adapter cote code. -->
                    <block name="stage2.wave" symbol="stage.wave">
                        <asm filename="src/stages/02/objid.const.asm"/>
                        <asm filename="src/stages/02/wave.asm"/>
                    </block>
                </pageset>

                <!-- Les deux tables de carte, dans leur page                  -->
                <direntry name="stage2.maps" loadtimelink="LINK">
                    <lwasm gensource="gen/stages/02/stage2-maps.asm">
                        <asm filename="engine/system/to8/map.const.asm"/>
                        <tilemap map="src/stages/02/map/intro/even.bin" label="map.even"
                                 tiles="tilesEven" variant="ND0"
                                 gensource="gen/stages/02/map-even.asm"/>
                        <tilemap map="src/stages/02/map/intro/odd.bin" label="map.odd"
                                 tiles="tilesOdd" variant="ND0"
                                 gensource="gen/stages/02/map-odd.asm"/>
                    </lwasm>
                </direntry>

                <direntry name="stage2" codec="zx0" loadtimelink="LINK">
                    <lwasm gensource="gen/stages/02/stage02-main.asm">
                        <asm filename="gen/directories/disk0/entries.asm"/>
                        <asm filename="src/stages/02/main.asm"/>
                        <png2pal symbol="Pal_stage" filename="src/stages/02/map/intro/even.png"/>
                    </lwasm>
                </direntry>

                <!-- Les scènes. Celle du boot charge le moteur ET le stage 1 ; -->
                <!-- les deux autres ne rechargent que ce qui change, le        -->
                <!-- moteur restant en place par simple absence de la liste.    -->
                <!-- ******************************************************** -->
                <scene name="scenes.boot" section="SCENE" gensource="gen/scenes/boot.asm">
                    <load name="common.engine"     region="common"/>
                    <load name="common.anim"       region="anim"/>
                    <load name="common.enemies"    region="enemies"/>
                    <load name="stage1.tiles.even"  region="tiles.even"/>
                    <load name="stage1.tiles.odd"   region="tiles.odd"/>
                    <load name="stage1.maps"         region="maps"/>
                    <load name="stage1"             region="stage"/>
                </scene>

                <scene name="scenes.stage1" section="SCENE" gensource="gen/scenes/stage1.asm">
                    <load name="stage1.tiles.even"  region="tiles.even"/>
                    <load name="stage1.tiles.odd"   region="tiles.odd"/>
                    <load name="stage1.maps"         region="maps"/>
                    <load name="stage1"             region="stage"/>
                </scene>

                <scene name="scenes.stage2" section="SCENE" gensource="gen/scenes/stage2.asm">
                    <load name="stage2.tiles.even" region="tiles.even"/>
                    <load name="stage2.tiles.odd"  region="tiles.odd"/>
                    <load name="stage2.maps"       region="maps"/>
                    <load name="stage2"            region="stage"/>
                </scene>

            </directory>

            <!-- Boot loader -->
            <!-- *********************************************************** -->
            <!-- Le pool porte les donnees de lien de tout ce qui est charge. Le    -->
            <!-- moteur en pese 2,5 Ko a lui seul depuis qu'il embarque la chaine   -->
            <!-- sprites, et un echange de stage alloue le nouveau avant de         -->
            <!-- liberer l'ancien : 4 Ko ne suffisent plus.                          -->
            <define symbol="loader.DEFAULT_DYNAMIC_MEMORY_SIZE" value="$2000"/>
            <define symbol="boot.CHECK_MEMORY_EXT"/>

            <data section="LOADER">
                <lwasm format="raw" gensource="gen/bootloader/loader.asm">
                    <asm filename="gen/directories/disk0/entries.asm"/>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_DIR_ID    equ 0</asm>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_EXEC_PAGE equ 1</asm>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_EXEC_ADDR equ $8300</asm>
                    <asm xml:space="preserve">loader.DEFAULT_SCENE_FILE_ID   equ scenes.boot</asm>
                    <asm filename="engine/system/to8/bootloader/loader.asm"/>
                </lwasm>
            </data>

            <data section="BOOT" maxsize="0x100">
                <cksumfd640>
                    <lwasm format="raw">
                        <asm filename="engine/system/to8/bootloader/boot.asm"/>
                    </lwasm>
                </cksumfd640>
            </data>

            <fd  filename="to8.fd"/>
            <sd  filename="to8.sd"/>
            <sap filename="to8.sap"/>
        </floppydisk>
    </target>
</configuration>
