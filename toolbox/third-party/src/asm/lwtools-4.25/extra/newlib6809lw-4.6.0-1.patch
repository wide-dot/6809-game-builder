diff --git a/newlib/libc/include/sys/_intsup.h b/newlib/libc/include/sys/_intsup.h
index 993121b..eb441a3 100644
--- a/newlib/libc/include/sys/_intsup.h
+++ b/newlib/libc/include/sys/_intsup.h
@@ -19,6 +19,33 @@
 #include <limits.h>
 #endif
 
+/*
+ * M6809: GCC 4.6 doesn't provide __INT*_TYPE__ builtins, so we define
+ * the type mapping constants directly.
+ *   int8_t   = signed char       -> "hh"
+ *   int16_t  = signed int        -> ""    (int is 16-bit)
+ *   int32_t  = signed long       -> "l"
+ *   intptr_t = signed int        -> _INTPTR_EQ_INT
+ *   No 64-bit types.
+ */
+#if defined(__m6809__)
+#define _INTPTR_EQ_INT
+#define _INT32_EQ_LONG
+#define __INT8 "hh"
+#define __INT16
+#define __INT32 "l"
+/* no __INT64 — m6809 has no 64-bit type */
+#define __FAST8 "hh"
+#define __FAST16
+#define __FAST32 "l"
+/* no __FAST64 */
+#define __LEAST8 "hh"
+#define __LEAST16
+#define __LEAST32 "l"
+/* no __LEAST64 */
+
+#else /* !__m6809__ */
+
 /* Determine how intptr_t and intN_t fastN_t and leastN_t are defined by gcc
    for this target.  This is used to determine the correct printf() constant in
    inttypes.h and other  constants in stdint.h.
@@ -196,4 +223,6 @@
 #pragma pop_macro("int")
 #pragma pop_macro("long")
 
+#endif /* !__m6809__ */
+
 #endif /* _SYS__INTSUP_H */
