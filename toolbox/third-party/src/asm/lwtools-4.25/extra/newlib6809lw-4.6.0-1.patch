diff --git a/newlib/libc/include/machine/_default_types.h b/newlib/libc/include/machine/_default_types.h
index 6137493..f2b47a0 100644
--- a/newlib/libc/include/machine/_default_types.h
+++ b/newlib/libc/include/machine/_default_types.h
@@ -37,6 +37,61 @@
 extern "C" {
 #endif
 
+/*
+ * M6809: GCC 4.6 doesn't define __INT*_TYPE__ builtins.
+ * Provide explicit type definitions for this target.
+ *   char = 8 bits, int/short = 16 bits, long = 32 bits
+ *   long long = 32 bits (no 64-bit support)
+ *   pointers = 16 bits
+ */
+#if defined(__m6809__)
+
+typedef signed char __int8_t;
+typedef unsigned char __uint8_t;
+#define ___int8_t_defined 1
+
+typedef signed int __int16_t;
+typedef unsigned int __uint16_t;
+#define ___int16_t_defined 1
+
+typedef signed long __int32_t;
+typedef unsigned long __uint32_t;
+#define ___int32_t_defined 1
+
+/*
+ * m6809 long long is only 32 bits, so "64-bit" types are actually 32-bit.
+ * This is the best we can do; code using 64-bit arithmetic will not get
+ * true 64-bit range but at least the types will exist for compilation.
+ */
+typedef signed long __int64_t;
+typedef unsigned long __uint64_t;
+#define ___int64_t_defined 1
+
+typedef signed char __int_least8_t;
+typedef unsigned char __uint_least8_t;
+#define ___int_least8_t_defined 1
+
+typedef signed int __int_least16_t;
+typedef unsigned int __uint_least16_t;
+#define ___int_least16_t_defined 1
+
+typedef signed long __int_least32_t;
+typedef unsigned long __uint_least32_t;
+#define ___int_least32_t_defined 1
+
+typedef signed long __int_least64_t;
+typedef unsigned long __uint_least64_t;
+#define ___int_least64_t_defined 1
+
+typedef signed long __intmax_t;
+typedef unsigned long __uintmax_t;
+
+typedef signed int __intptr_t;
+typedef unsigned int __uintptr_t;
+#define ___intptr_t_defined 1
+
+#else /* !__m6809__ */
+
 #ifdef __INT8_TYPE__
 typedef __INT8_TYPE__ __int8_t;
 #ifdef __UINT8_TYPE__
@@ -243,6 +298,8 @@ typedef unsigned long __uintptr_t;
 
 #undef __EXP
 
+#endif /* !__m6809__ */
+
 #ifdef __cplusplus
 }
 #endif
