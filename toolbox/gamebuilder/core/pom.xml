<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.wide-dot</groupId>
		<artifactId>6809-gamebuilder</artifactId>
		<version>0.0.1</version>
		<relativePath>../../../pom.xml</relativePath>
	</parent>
	<artifactId>6809-gamebuilder-core</artifactId>
	<packaging>jar</packaging>

	<properties>
		<main-class>com.widedot.m6809.gamebuilder.MainCommand</main-class>
	</properties>

  <dependencies>
    <!-- asset converters, registered in Handlers -->
    <dependency>
      <artifactId>vgm2ymm</artifactId>
      <groupId>com.wide-dot</groupId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <artifactId>vgm2vgc</artifactId>
      <groupId>com.wide-dot</groupId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <artifactId>vgm2sfx</artifactId>
      <groupId>com.wide-dot</groupId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <artifactId>pcm</artifactId>
      <groupId>com.wide-dot</groupId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.wide-dot</groupId>
      <artifactId>gfxcomp</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.wide-dot</groupId>
      <artifactId>leanscroll</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.wide-dot</groupId>
      <artifactId>png2pal</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.wide-dot</groupId>
      <artifactId>png2bin</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <artifactId>txt2bas</artifactId>
      <groupId>com.wide-dot</groupId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <artifactId>phoneme</artifactId>
      <groupId>com.wide-dot</groupId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <artifactId>6809-gamebuilder-spi</artifactId>
      <groupId>com.wide-dot</groupId>
      <version>0.0.1</version>
    </dependency>
    <dependency>
      <artifactId>6809-gamebuilder-util</artifactId>
      <groupId>com.wide-dot</groupId>
      <version>0.0.1</version>
    </dependency>
  </dependencies>

	<build>
		<plugins>
			<plugin>
				<artifactId>maven-assembly-plugin</artifactId>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>
						<configuration>
							<skipAssembly>false</skipAssembly>
							<archive>
								<manifest>
									<mainClass>com.widedot.m6809.gamebuilder.MainCommand</mainClass>
								</manifest>
							</archive>
							<descriptors>
								<descriptor>./src/main/packaging/engine-packaging.xml</descriptor>
							</descriptors>
							<finalName>engine</finalName>
							<appendAssemblyId>false</appendAssemblyId>
							<outputDirectory>${project.basedir}/src/main/resources</outputDirectory>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>appassembler-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>assemble-linux</id>
						<goals>
							<goal>assemble</goal>
						</goals>
						<phase>package</phase>
						<configuration>
							<assembleDirectory>${project.parent.basedir}</assembleDirectory>
							<binFolder>/bin/unix</binFolder>
							<repositoryName>repo</repositoryName>							
							<programs>
								<program>
									<platforms>
										<platform>unix</platform>
									</platforms>
									<mainClass>${main-class}</mainClass>
									<id>${project.artifactId}</id>
								</program>
							</programs>
		    				<repositoryLayout>flat</repositoryLayout>
		    				<useWildcardClassPath>true</useWildcardClassPath>
						</configuration>
					</execution>
					<execution>
						<id>assemble-win</id>
						<goals>
							<goal>assemble</goal>
						</goals>
						<phase>package</phase>
						<configuration>
							<assembleDirectory>${project.parent.basedir}</assembleDirectory>							
							<binFolder>/bin/windows</binFolder>
							<repositoryName>repo</repositoryName>							
							<programs>
								<program>
									<platforms>
										<platform>windows</platform>
									</platforms>
									<mainClass>${main-class}</mainClass>
									<id>${project.artifactId}</id>
								</program>
							</programs>
		    				<repositoryLayout>flat</repositoryLayout>
		    				<useWildcardClassPath>true</useWildcardClassPath>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
